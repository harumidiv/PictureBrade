    "「……しりとりは『ん』でおしまい。キミの勝ちだよ」" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«… A les paraules encadenades, la «ん» és el final. Has guanyat.»"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„…Ve slovním fotbalu nic nezačíná na „ん“, takže je konec. Vyhráls“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”…Ordkæden slutter med ”ん”. Du har vundet.”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„… Bei der Wortkette ist mit „ん“ Schluss – kein Wort fängt damit an. Du hast gewonnen.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«…Στην αλυσίδα των λέξεων, όποιος φτάσει στο “ん” χάνει. Κέρδισες.»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"...In Shiritori, the word chain ends at “ん”. You win.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“…En la cadena de palabras, la “ん” significa el final. Has ganado tú.”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”…Sanaketju päättyy ”ん”-kirjaimeen. Sinä voitit.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« … Au jeu des mots en chaîne, « ん » marque la fin. Tu as gagné. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“...शब्द-श्रृंखला के खेल में “ん” आया, तो खेल ख़त्म। तुम जीत गए।”"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»…Lanac riječi završava na „ん“. Pobijedio si.«"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„……A szólánc „ん”-nel ér véget. Te nyertél.”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“……Sambung kata berakhir di “ん”. Kamu yang menang.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«… Nelle parole a catena, «ん» è la fine. Hai vinto tu.»"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“……끝말잇기는 ‘ん’이 나오면 끝이야. 네가 이겼어”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“...Dalam permainan sambung kata, “ん” bermakna tamat. Kamu menang.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«…Ordkjeden slutter med «ん». Du har vunnet.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“…Een woord op ‘ん’ maakt een einde aan de woordketting. Jij hebt gewonnen.”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„…W łańcuszku słów nic nie zaczyna się na „ん”, więc to koniec. Wygrałeś”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“…Nas palavras encadeadas, o “ん” é o fim. Você venceu.”"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«…Nas palavras encadeadas, o “ん” é o fim. Ganhaste tu.»"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«……Lanțul de cuvinte se termină cu „ん”. Ai câștigat!»"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«……Игра в слова заканчивается на «ん». Ты победил»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„…V slovnom futbale nič nezačína na „ん“, takže je koniec. Vyhral si“"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”…En ordkedja tar slut vid ”ん”. Du vann.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“……เกมต่อคำจบลงเมื่อเจอ ‘ん’ เธอชนะแล้วล่ะ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“...Kelime zinciri “ん” ile biter. Sen kazandın.”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«…Ланцюжок слів закінчується на «ん». Ти переміг»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“……Nối từ mà gặp chữ ‘ん’ là hết. Cậu thắng rồi”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“……文字接龙到“ん”就结束了。是你赢了。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「……文字接龍到「ん」就結束了。是你贏了。」"
          }
        }
      }
    },
