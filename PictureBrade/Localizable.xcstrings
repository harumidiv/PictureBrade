        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem tudtam kivédeni……. A fa szívós ám"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak sanggup menangkis semuanya……. Si “木” itu ulet, lho"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
