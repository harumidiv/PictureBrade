          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่นี่คือปราสาทจอมราชันย์ ข้า “魔” ผู้เฝ้าประตู ปล่อยให้ผ่านไปไม่ได้หรอกนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burası Hükümdar'ın kalesi. Kapı bekçisi ben, “魔”, seni geçiremem, canım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це замок Володаря. Я, вартовий «魔», тебе не пропущу-у"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là lâu đài của Bá Vương. Ta, “魔” gác cổng, không thể để ngươi qua đâu nhé"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里是霸王之城。身为守门人的“魔”，可不能放你过去呢"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡是霸王之城。身為守門人的「魔」，可不能放你過去呢"
          }
        }
      }
    },
