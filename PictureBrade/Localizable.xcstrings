        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prati hiragana slova koja su pobjegla iz Dječje zemlje sve do Tornja lanca riječi!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
