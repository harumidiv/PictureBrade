        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूटते तारे से मन्नत? उसका वक़्त नहीं दूँगा! पल भर में जलकर ख़ाक हो जाओ!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaželjeti želju zvijezdi padalici? Za to nema vremena! Izgori u trenu!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kívánni szeretnél egy hullócsillagnál? Arra nem lesz időd! Égj el egy szempillantás alatt!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mau minta permohonan ke bintang jatuh? Nggak ada waktu! Terbakar habis dalam sekejap!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un desiderio alla stella cadente? Non c'è tempo! Brucia in un istante!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별똥별에 소원을? 그럴 틈은 안 준다! 한순간에 타 버려라!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nak buat hajat pada tahi bintang? Tiada masa! Terbakarlah dalam sekelip mata!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ønske deg noe ved et stjerneskudd? Det har du ikke tid til! Brenn opp på et øyeblikk!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wens doen bij een vallende ster? Daar krijg je geen tijd voor! Verbrand in een flits!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Życzenie do spadającej gwiazdy? Nie dam ci czasu! Spłoń w mgnieniu oka!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazer um pedido para a estrela cadente? Não vou te dar tempo! Queime num instante!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir um desejo à estrela cadente? Não te dou tempo! Arde num instante!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți pui o dorință la o stea căzătoare? N-ai timp! Arzi într-o clipă!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загадать желание на падающую звезду? Не успеешь! Сгори в одно мгновение!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želanie padajúcej hviezde? Na to ti nedám čas! Zhor v okamihu!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önska dig något av ett stjärnfall? Det hinner du inte! Brinn upp på ett ögonblick!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอพรกับดาวตกเหรอ? ไม่มีเวลาให้หรอก! มอดไหม้ในพริบตาซะ!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayan yıldıza dilek mi? Buna vakit tanımam! Bir anda yanıp kül ol!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загадати бажання на падаючу зірку? Не встигнеш! Згори в одну мить!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ước nguyện với sao băng à? Không có thời gian đâu! Cháy rụi trong chớp mắt đi!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对着流星许愿？才不给你这个时间！一瞬间燃烧殆尽吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對著流星許願？才不給你這個時間！一瞬間燃燒殆盡吧！"
          }
        }
      }
    },
