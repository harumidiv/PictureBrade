    "ガオォォ！　ジャングルの王、ライオン様だ！　このドットカメラで、キミのコマもカクカクのドット絵にしてやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraau! Soc el Lleó, rei de la jungla! Amb la meva càmera de píxels, convertiré la teva baldufa en pixel art quadradet!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Jsem Lev, král džungle! Tímhle pixelovým foťákem udělám z tvé káči hranatý pixel-art!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rooaar! Jeg er junglens konge, den store løve! Med mit pixelkamera forvandler jeg din top til kantet pixelkunst!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roooar! Ich bin der König des Dschungels, Löwe der Große! Mit dieser Pixelkamera mache ich auch aus deinem Kreisel ein klotziges Pixelbild!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γκρρρ! Είμαι ο Λέων, ο βασιλιάς της ζούγκλας! Με αυτή την πίξελ κάμερα θα κάνω τη σβούρα σου κουτσουρεμένα πιξελάκια!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ROAR! I'm the King of the Jungle, Lord Lion! With this Pixel Camera, I'll turn your top into blocky pixel art!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Grooaar! ¡Soy el León, rey de la jungla! ¡Con esta cámara de píxeles convertiré tu trompo en pixel art cuadradito!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rooaar! Olen viidakon kuningas, suuri leijona! Pikselikamerallani muutan hyrräsi kulmikkaaksi pikselitaiteeksi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graou ! Je suis le Lion, roi de la jungle ! Avec mon appareil photo pixel, je vais transformer ta toupie en pixel art tout carré !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दहाड़! जंगल का राजा, शेर महाराज! इस पिक्सल कैमरे से तुम्हारा लट्टू भी चौकोर पिक्सल आर्ट बना दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Ja sam lav, kralj džungle! Ovom pikselnom kamerom pretvorit ću tvoju čigru u kockastu pikselsku sličicu!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrrr! Én vagyok a dzsungel királya, Oroszlán úr! Ezzel a pixelkamerával a pörgettyűdet is kockás pixelrajzzá változtatom!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Akulah raja rimba, Tuan Singa! Dengan kamera piksel ini, gasingmu akan kujadikan gambar piksel kotak-kotak!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roaaar! Sono il Leone, re della giungla! Con la mia fotocamera pixel trasformerò la tua trottola in pixel art tutta squadrata!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어흥! 정글의 왕, 사자님이시다! 이 도트 카메라로 네 팽이도 각진 도트 그림으로 만들어 주마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngauman! Akulah raja rimba, Tuan Singa! Dengan kamera piksel ini, gasing kamu akan jadi seni piksel berpetak-petak!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rooaar! Jeg er jungelens konge, den store løven! Med pikselkameraet mitt gjør jeg snurrebassen din om til kantete pikselkunst!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grraaah! Ik ben de koning van de jungle, Heer Leeuw! Met deze pixelcamera maak ik van jouw tol een blokkerig pixelplaatje!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Jestem Lew, król dżungli! Tym pikselowym aparatem zmienię twojego bączka w kanciasty piksel-art!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groaaar! Sou o Leão, rei da selva! Com esta câmera de pixels, vou transformar seu pião em pixel art quadradinho!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groaaar! Sou o Leão, rei da selva! Com esta câmara de píxeis, vou transformar o teu pião em pixel art aos quadradinhos!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaau! Eu sunt Leul, regele junglei! Cu camera mea pixelată îți transform titirezul într-un desen cu pixeli!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Р-р-р-ррр! Я царь джунглей, господин Лев! Моей пиксельной камерой я превращу твой волчок в угловатую пиксельную картинку!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Som Lev, kráľ džungle! Týmto pixelovým foťákom spravím z tvojho vĺčika hranatý pixel-art!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rooaar! Jag är djungelns kung, Lejonet! Med min pixelkamera gör jag din snurra till kantig pixelkonst!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฮกกก! ข้าคือสิงโต ราชาแห่งป่า! ด้วยกล้องพิกเซลนี้ จะเปลี่ยนลูกข่างของเจ้าเป็นภาพพิกเซลเหลี่ยมๆ!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrraaa! Ben ormanların kralı Aslan Hazretleri! Bu piksel kamerayla senin topacını da köşeli bir piksel resme çevireceğim!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Р-р-р! Я Лев, цар джунглів! Цією піксельною камерою я перетворю твою дзиґу на кутасту піксельну картинку!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gràooo! Ta là Sư Tử, vua của rừng xanh! Với máy ảnh pixel này, ta sẽ biến con quay của ngươi thành tranh pixel vuông vức!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗷呜呜！我就是丛林之王，狮子大人！我要用这台像素相机，把你的陀螺也变成方块块的像素画！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗷嗚嗚！我就是叢林之王，獅子大人！我要用這台像素相機，把你的陀螺也變成方塊塊的像素畫！"
          }
        }
      }
    },
    "ガガガッ！　点々2つで、「か」が「が」に変身だ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga! Amb dos puntets, la «か» es transforma en «が»!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga! Dvě tečky a „か“ se změní na „が“!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagaga! Med to små prikker forvandles ”か” til ”が”!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga! Zwei Strichlein, und schon wird „か“ zu „が“!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γκα-γκα-γκα! Με δύο τελίτσες, το «か» μεταμορφώνεται σε «が»!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-gah! Add two little dots, and “か” (ka) transforms into “が” (ga)!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ga-ga-ga! ¡Con dos puntitos, la “ka” se transforma en “ga”!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagaga! Kahdella pikku pisteellä ”か” muuttuu ”が”:ksi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga ! Avec deux petits points, « か » se transforme en « が » !"
