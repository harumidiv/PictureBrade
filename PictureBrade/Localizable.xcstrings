    "ま、まっすぐすぎた……。キミのコマ、なかなか曲者だな" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M… massa recte… La teva baldufa és més espavilada del que sembla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B-byl jsem až moc přímý… Tvoje káča je pěkný šibal"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J-jeg var for lige… Din top er en snu en"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-zu geradlinig … Dein Kreisel ist ganz schön gerissen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Π-πολύ ίσιος ήμουν… Η σβούρα σου είναι πονηρούλα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-too straight... Your top is a tricky one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De… demasiado recto… Tu trompo es todo un pillo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O-olin liian suora… Hyrräsi on melkoinen veijari"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T… trop droit… Ta toupie est plus maligne qu'elle n'en a l'air."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब-बहुत ज़्यादा सीधा था... तुम्हारा लट्टू बड़ा चालाक है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B-bio sam previše ravan… Tvoja čigra je baš lukava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-túl egyenes voltam……. A pörgettyűd elég ravasz jószág"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-terlalu lurus……. Gasingmu licik juga, ya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T… troppo dritto… La tua trottola è più furba di quanto sembri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너, 너무 곧았나……. 네 팽이, 꽤 만만치 않군"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-terlalu lurus... Gasing kamu memang licik"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J-jeg var for rett … Snurrebassen din er en lur en"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-te recht door zee… Jouw tol is een sluwe, zeg"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-zbyt prostolinijny byłem… Twój bączek to niezły spryciarz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C-certinho demais… Seu pião é bem malandro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-direito demais… O teu pião é um grande maroto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A-am fost prea drept……Titirezul tău e un șiret, nu glumă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С-слишком прямолинейно……. А твой волчок — хитрец"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B-bol som až príliš priamy… Tvoj vĺčik je poriadny šibal"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F-för rak… Din snurra är en riktig luring"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตะ……ตรงเกินไปสินะ…… ลูกข่างของเจ้า ร้ายใช่เล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F-fazla dümdüzdüm... Senin topacın amma kurnazmış"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З-задуже прямо вийшло… Твоя дзиґа — ще та хитрунка"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-thẳng quá rồi……. Con quay của ngươi đúng là khó chơi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太、太直了……你的陀螺还真是不好对付"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太、太直了……你的陀螺還真是不好對付"
          }
        }
      }
    },
    "まいっ……た……。このバネ、キミが使って。ぶつかるたびに、びよーんって鳴るよ。塔には、昔のひらがなたちが待っている" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em… rendeixo… Queda't aquesta molla. A cada xoc farà «boing!». A la torre t'esperen els hiragana d'antany."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdávám… se… Vezmi si tu pružinu. Při každém nárazu udělá „boing“. Ve věži čeká stará hiragana"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg… giver op… Brug du denne fjeder. Den siger boing, hver gang du støder ind i noget. I tårnet venter de gamle hiraganaer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich geb … auf … Nimm diese Feder. Bei jedem Treffer macht sie boing! Im Turm warten die alten Hiragana"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νι-νικήθηκα… Πάρε αυτό το ελατήριο. Σε κάθε σύγκρουση θα κάνει μπόινγκ. Στον πύργο σε περιμένουν τα παλιά χιραγκάνα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I give... up... Use this spring. It'll go boing every time you clash. In the tower, the hiragana of olden days are waiting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me… rin… do… Usa tú este resorte. Cada vez que choques, hará “¡boing!”. En la torre te esperan los hiraganas antiguos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minä… luovutan… Käytä sinä tätä jousta. Se sanoo poing aina, kun törmäät johonkin. Tornissa odottavat muinaiset hiraganat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je… capitule… Prends ce ressort. À chaque choc, il fera « boing ! ». Dans la tour, les hiragana d'autrefois t'attendent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा... र... गया... ये स्प्रिंग तुम ले लो। हर टक्कर पर बोइंग बजेगा। मीनार में पुराने हिरागाना इंतज़ार कर रहे हैं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pr-pre…dajem se… Uzmi ovu oprugu. Pri svakom udarcu reći će „boing“. U tornju te čekaju stara hiragana slova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fel……adom……. Használd te ezt a rugót. Minden ütközésnél boing-ot szól. A toronyban a régi hiraganák várnak rád"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku me-nyerah……. Per ini, pakailah. Setiap bertabrakan, bunyinya boing. Di menara, hiragana kuno sudah menunggu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi… arrendo… Prendi questa molla. A ogni scontro farà «boing!». Nella torre ti aspettano gli hiragana di una volta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "졌……다……. 이 스프링, 네가 써. 부딪칠 때마다 뾰옹 하고 울릴 거야. 탑에는 옛날 히라가나들이 기다리고 있어"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku... menyerah... Spring ini untuk kamu. Setiap kali berlanggar, ia berbunyi boing. Di menara, hiragana purba sedang menunggu"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg … gir meg … Bruk du denne fjæra. Den sier boing hver gang du dunker borti noe. I tårnet venter de gamle hiraganaene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik… geef me… gewonnen… Gebruik jij deze veer maar. Bij elke botsing klinkt een boing. In de toren wachten de hiragana van vroeger"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poddaję… się… Weź tę sprężynę. Przy każdym zderzeniu zrobi „boing”. W wieży czekają dawne hiragany"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu… de… sis… to… Use você esta mola. A cada batida, ela faz “boing!”. Na torre esperam os hiraganas antigos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De… sis… to… Usa tu esta mola. A cada choque, faz «boing!». Na torre esperam-te os hiraganas antigos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M-ai……bătut……Folosește tu arcul ăsta. La fiecare lovitură face boing. În turn te așteaptă hiragana de altădată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сда……юсь……. Эта пружина — тебе. При каждом ударе она будет делать «боинг». А в башне тебя ждут древние буквы хираганы"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdávam… sa… Vezmi si túto pružinu. Pri každom náraze urobí „boing“. Vo veži čaká stará hiragana"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag… ger… mig… Ta fjädern. Den säger boing vid varje smäll. I tornet väntar de gamla hiraganatecknen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยอม……แล้ว…… สปริงนี้ เธอเอาไปใช้เถอะ ชนทีไรจะดังดึ๋ง บนหอคอยมีฮิรางานะโบราณรออยู่นะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pes... ettim... Bu yayı sen kullan. Her çarpışmada boing diye ses çıkarır. Kulede eski hiraganalar bekliyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З-здаюся… Бери цю пружину. При кожному зіткненні вона робитиме «бо-о-оїнь». У вежі на тебе чекає давня хіраґана"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thua……rồi……. Lò xo này cậu dùng đi. Mỗi lần va chạm sẽ kêu tưng tưng đó. Trên tháp, các chữ hiragana cổ đang đợi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我认……输……这个弹簧给你用吧。每次碰撞都会发出“啵嘤”的声音哦。塔里，古时候的平假名们正在等着你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我認……輸……這個彈簧給你用吧。每次碰撞都會發出「啵嚶」的聲音喔。塔裡，古時候的平假名們正在等著你"
          }
        }
      }
    },
