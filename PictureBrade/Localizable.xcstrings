    "硬くて重い、それが金！　キラキラ回って跳ね返してやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dur i pesant, això és el metall «金»! Giro brillant i et faig rebotar!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvrdé a těžké — to je zlato! Třpytivě tě odrazím!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hård og tung – det er guld! Glimtende snurrer jeg og slår dig tilbage!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hart und schwer – das ist Gold! Funkelnd drehe ich mich und lasse dich abprallen!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκληρό και βαρύ: αυτό είναι ο χρυσός! Θα γυρίσω αστραφτερά και θα σε απωθήσω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard and heavy — that's 金, metal! I'll sparkle and spin and bounce you right back!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Duro y pesado, eso es el metal! ¡Giro brillando y te hago rebotar!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kova ja raskas – se on kulta! Kimallellen pyörin ja kimmotan sinut takaisin!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dur et lourd, c'est ça, le métal « 金 » ! Je tourne en brillant et je te renvoie !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सख़्त और भारी, यही है सोना! चमचमाते घुमाव से तुम्हें उछाल दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvrd i težak — to je metal! Vrtim se svjetlucavo i odbijam sve!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemény és nehéz: ez az arany! Csillogva pörgök, és visszaverlek!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keras dan berat, itulah emas! Kuberputar berkilau dan kupantulkan kamu!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duro e pesante, ecco il metallo «金»! Giro scintillando e ti faccio rimbalzare!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단단하고 무거운, 그게 바로 “金”! 반짝반짝 돌면서 튕겨 내 주마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keras dan berat, itulah emas! Aku berputar berkilauan dan melantunkan kamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard og tung – det er gull! Glitrende snurrer jeg og slår deg tilbake!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard en zwaar, dat is goud! Glinsterend draai ik en kaats ik je terug!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twarde i ciężkie — to złoto! Błyszcząco cię odbiję!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duro e pesado, isso é o metal! Vou girar brilhando e rebater você!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duro e pesado, isso é o metal! Vou girar a brilhar e fazer-te ressaltar!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tare și greu, asta e „金”, metalul! Mă rotesc sclipind și te arunc înapoi!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твёрдое и тяжёлое — это металл! Сверкаю, кручусь и отбиваю!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvrdé a ťažké — to je zlato! Trblietavo ťa odrazím!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hård och tung, det är metall – guld! Jag glittrar och studsar tillbaka dig!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แข็งและหนัก นั่นแหละ “金”! จะหมุนวิบวับแล้วดีดเจ้ากระเด็น!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert ve ağır, işte altın! Pırıl pırıl dönüp seni geri sektireceğim!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твердий і важкий — це золото! Блискуче кружляю й відбиваю все!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vừa cứng vừa nặng, đó là “金”! Ta sẽ quay lấp lánh và đẩy bật ngươi!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又硬又重，那就是“金”！闪闪发亮地旋转，把你弹回去！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又硬又重，那就是「金」！閃閃發亮地旋轉，把你彈回去！"
          }
        }
      }
    },
