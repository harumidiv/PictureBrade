    "ブーン！　アクセル全開、ハンドルさばきには自信があるぜ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brrrum! Accelerador a fons, soc un as del volant!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brm! Plný plyn, a za volantem jsem mistr!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroom! Speederen i bund – jeg er en haj til at styre!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brumm! Vollgas – und am Lenkrad macht mir keiner was vor!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρουμ! Γκάζι στο φουλ — στο τιμόνι δεν με φτάνει κανείς!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroom! Pedal to the metal — nobody handles the wheel like me!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Brrrum! Acelerador a fondo. Al volante no me gana nadie"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrrruum! Kaasu pohjassa – ratissa olen mestari!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroum ! Accélérateur à fond, je suis un as du volant !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्रूम! फ़ुल एक्सीलरेटर, स्टीयरिंग में मेरा कोई जवाब नहीं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brrrum! Gas do daske — u volan sam siguran!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brrrrum! Padlógáz, és a kormányzásban verhetetlen vagyok!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brrrm! Gas pol, aku jago menyetir!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brum brum! Acceleratore a tavoletta, al volante sono un asso!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부릉! 액셀 풀로! 핸들링엔 자신 있다고"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroom! Pedal minyak habis, bab memandu aku memang yakin"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroom! Gassen i bånn – jeg er en racer bak rattet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroem! Plankgas! Op mijn stuurmanskunst ben ik trots"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brum! Gaz do dechy, a za kierownicą jestem mistrzem!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrum! Acelerador no talo. No volante ninguém me vence"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrum! Acelerador a fundo. Ao volante ninguém me ganha"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrrrum! Accelerația la maxim — la volan sunt cel mai tare!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Врум! Газ в пол — за рулём мне нет равных!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brm! Plný plyn, a za volantom som majster!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vroom! Gasen i botten – och jag kan verkligen styra!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บรื้น! เหยียบมิด ฝีมือบังคับพวงมาลัยไม่เป็นรองใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vınnn! Gaza sonuna kadar bastım, direksiyonda üstüme yoktur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вр-р-рум! Газ до упору, а кермую я віртуозно!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brừm! Hết ga luôn, tay lái này là đỉnh của chóp đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轰轰！油门踩到底，我的方向盘技术可是一流的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轟轟！油門踩到底，我的方向盤技術可是一流的！"
          }
        }
      }
    },
