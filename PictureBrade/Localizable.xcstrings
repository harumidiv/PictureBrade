        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गगगा! दो बिंदु लगते ही “か” बन गया “が”!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga! Dvije točkice i „か“ postaje „が“!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
