    "ライフがありません。回復を待つか、広告を見て回復しよう" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No et queden vides. Espera que es recarreguin o mira un anunci per recuperar-ne"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemáš životy. Počkej, až se obnoví, nebo se podívej na reklamu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke flere liv. Vent på, at de kommer igen, eller se en reklame"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Leben mehr. Warte, bis sie sich auffüllen, oder schau dir eine Werbung an"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχεις ζωές. Περίμενε να γεμίσουν ή δες μια διαφήμιση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're out of lives. Wait for them to refill, or watch an ad to recover"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te quedan vidas. Espera a que se recuperen o mira un anuncio para recuperarlas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elämät loppuivat. Odota, että ne palautuvat, tai katso mainos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de vies. Attends qu'elles se rechargent ou regarde une pub pour en récupérer"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइफ़ नहीं बची। रिकवर होने का इंतज़ार करो, या ऐड देखकर रिकवर करो"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemaš života. Pričekaj da se obnove ili pogledaj oglas"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs több életed. Várd meg, míg visszatöltődik, vagy nézz meg egy reklámot"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyawa habis. Tunggu pulih atau tonton iklan untuk memulihkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente vite. Aspetta che si ricarichino o guarda una pubblicità per recuperarne"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이프가 없어요. 회복을 기다리거나 광고를 보고 회복하자"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada nyawa. Tunggu ia pulih, atau tonton iklan untuk pulihkan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke flere liv. Vent til de fylles opp, eller se en reklame"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen levens meer. Wacht tot ze terugkomen of bekijk een advertentie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak żyć. Poczekaj, aż się odnowią, lub obejrzyj reklamę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está sem vidas. Espere elas recarregarem ou assista a um anúncio para recuperar"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tens vidas. Espera que recuperem ou vê um anúncio para as recuperares"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu mai ai vieți. Așteaptă să se refacă sau uită-te la o reclamă"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жизней нет. Подожди, пока они восстановятся, или посмотри рекламу"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemáš životy. Počkaj, kým sa obnovia, alebo si pozri reklamu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inga liv kvar. Vänta tills de fylls på, eller titta på en reklam"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชีวิตหมดแล้ว รอให้ฟื้นหรือดูโฆษณาเพื่อฟื้นชีวิตนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canın kalmadı. Dolmasını bekle ya da reklam izleyerek doldur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає життів. Зачекай на відновлення або переглянь рекламу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hết mạng rồi. Hãy chờ hồi phục hoặc xem quảng cáo để hồi phục nhé"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生命用完了。等待恢复，或观看广告来恢复吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生命用完了。等待恢復，或觀看廣告來恢復吧"
          }
        }
      }
    },
