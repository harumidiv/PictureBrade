        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux « 火 » l'un sur l'autre, ça fait « 炎 », la flamme ! Je ne suis pas du même niveau que le petit « 火 » de tout à l'heure !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
