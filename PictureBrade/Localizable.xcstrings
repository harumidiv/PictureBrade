        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔상이 보일 만큼 빠르게, 오래 돈다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat laju sampai nampak bayang, dan berputar lama"
