    "にっこり……できない……" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja no puc… somriure…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžu… se usmívat…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke… smile…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lächeln … geht nicht mehr …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν… μπορώ… να χαμογελάσω…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't... smile..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no… puedo sonreír…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pysty… hymyilemään…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus moyen… de sourire…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुस्कुरा... नहीं... पा रहा..."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne mogu… se… smješkati…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem……tudok……mosolyogni……"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak bisa…… senyum……"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riesco più… a sorridere…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방긋……못 하겠어……"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak... boleh... senyum..."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarer ikke … å smile …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan… niet meer… lachen…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie mogę… się uśmiechać…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consigo… mais sorrir…"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já não… consigo sorrir…"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu……mai pot……zâmbi……"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улыбнуться……не могу……"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemôžem… sa usmievať…"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte… le längre…"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ้ม……ไม่ออกแล้ว……"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gülümseye... mi... yorum..."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можу… усміхатися…"
          }
        },
