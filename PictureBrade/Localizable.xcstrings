          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagaga! Dengan dua titik, “か” berubah jadi “が”!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-ga-ga! Con due puntini, «か» si trasforma in «が»!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가가각! 점 두 개로 “か”가 “が”로 변신이다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagaga! Dengan dua titik, “か” bertukar jadi “が”!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
