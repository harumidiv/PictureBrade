          "stringUnit" : {
            "state" : "translated",
            "value" : "Fui tentado pelo diabinho… ou seja, por mim próprio…"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M-a ispitit diavolul……adică eu, „魔”, hehe……"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бес попутал……так, что ли……"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi… do mňa vošiel čert…"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djävulen… tog visst över…"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผีเข้า……สินะ……"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şeytan dürttü... galiba..."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мабуть… біс попутав…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bị ma xui quỷ khiến……chắc là vậy……"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大概是一时鬼迷心窍了吧……"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大概是一時鬼迷心竅了吧……"
          }
        }
      }
    },
