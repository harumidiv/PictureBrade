    "穴があったら……入りたい……" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em voldria… amagar dins del meu forat…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejradši bych se schoval do díry… třeba do té svojí…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg vil bare… krybe i et hul…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ich doch nur ein Loch hätte … zum Verstecken … oh, ich hab ja eins …"
