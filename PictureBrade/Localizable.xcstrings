    "龍虎相打つ！　龍を倒したなら、次はこの虎が相手だ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drac contra tigre! Has derrotat el drac? Doncs ara el teu rival soc jo, el tigre!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drak a tygr v souboji! Porazils draka? Teď se utkej s tygrem!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drage mod tiger! Har du slået dragen, så er det mig, tigeren, du er oppe imod!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drache gegen Tiger! Du hast den Drachen besiegt? Jetzt bekommst du es mit mir, dem Tiger, zu tun!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δράκος εναντίον τίγρης! Νίκησες τον δράκο; Τώρα θα τα βάλεις με την τίγρη!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragon versus tiger! You beat the dragon? Then this tiger is your next opponent!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Dragón contra tigre! ¡Si venciste al dragón, ahora te enfrentas a este tigre!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lohikäärme vastaan tiikeri! Jos voitit lohikäärmeen, seuraavaksi vastassasi on tiikeri!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragon contre tigre ! Tu as battu le dragon ? Alors c'est moi, le tigre, ton prochain adversaire !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्रैगन और बाघ की टक्कर! ड्रैगन को हरा दिया, तो अब ये बाघ तुमसे लड़ेगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmaj protiv tigra! Ako si pobijedio zmaja, sad ti je protivnik ovaj tigar!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sárkány és tigris összecsap! Ha a sárkányt legyőzted, most a tigris lesz az ellenfeled!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naga dan harimau beradu! Kalau kamu sudah mengalahkan naga, berikutnya akulah lawanmu, sang harimau!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drago contro tigre! Hai battuto il drago? Allora ora il tuo avversario sono io, la tigre!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용호상박! 용을 쓰러뜨렸다면, 다음은 이 호랑이가 상대다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naga dan harimau bertembung! Kalau kamu dah kalahkan naga, sekarang harimau ini lawan kamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drage mot tiger! Har du slått dragen, er det meg, tigeren, du møter nå!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draak en tijger in een titanenstrijd! Heb je de draak verslagen, dan is deze tijger nu aan de beurt!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smok i tygrys w starciu! Pokonałeś smoka? To teraz zmierz się z tygrysem!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragão contra tigre! Se você venceu o dragão, agora vai enfrentar este tigre!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragão contra tigre! Se venceste o dragão, agora vais enfrentar este tigre!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragon contra tigru! Dacă l-ai învins pe dragon, acum te înfrunți cu mine, tigrul!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дракон и тигр сошлись! Ты одолел дракона — теперь твой соперник я, тигр!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drak a tiger v súboji! Porazil si draka? Teraz sa utkaj s tigrom!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drake mot tiger! Har du besegrat draken är det min tur nu!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มังกรปะทะเสือ! ถ้าโค่นมังกรได้ ต่อไปเสือตัวนี้จะเป็นคู่ต่อสู้!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejderha ile kaplan karşı karşıya! Ejderhayı yendiysen sırada bu kaplan var!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дракон проти тигра! Ти здолав дракона — тепер битимешся з тигром!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long hổ tranh hùng! Đã hạ được rồng thì tiếp theo là hổ này!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "龙争虎斗！既然打倒了龙，下一个对手就是我这只虎！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "龍爭虎鬥！既然打倒了龍，下一個對手就是我這隻虎！"
          }
        }
      }
