    "ピコ……ピコ……。写真から生まれたコマ……計算外……。ホログラム装置は……キミにゆずる……" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… Una baldufa nascuda d'una foto… Error de càlcul… El meu aparell d'hologrames… te'l cedeixo…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Píp… píp… Káča z fotky… nebyla ve výpočtech… Hologenerátor… přenechám tobě…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… En top født af et foto… var ikke med i beregningerne… Hologram-maskinen… er din…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piep … piep … Ein Kreisel aus einem Foto … nicht berechnet … Das Hologramm-Gerät … gehört dir …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπιπ… μπιπ… Σβούρα γεννημένη από φωτογραφία… εκτός υπολογισμών… Τη συσκευή ολογραμμάτων… σου τη δίνω…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beep... boop... A top born from a photo... does not compute... The hologram device... is yours..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… Un trompo nacido de una foto… no estaba en mis cálculos… El dispositivo holográfico… es tuyo…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piip… piip… Valokuvasta syntynyt hyrrä… ei ollut laskelmissa… Hologrammilaite… on sinun…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… Une toupie née d'une photo… Erreur de calcul… Mon appareil à hologrammes… je te le cède…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीप... बीप... फ़ोटो से बना लट्टू... हिसाब से बाहर... होलोग्राम यंत्र... तुम्हें देता हूँ..."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… Čigra rođena iz fotografije… nije bila u izračunu… Hologram-uređaj… prepuštam tebi…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pity……pity……. Fényképből született pörgettyű……ez nem volt a számításban……. A hologram-gépet……neked adom……"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piko……piko……. Gasing yang lahir dari foto…… di luar perhitungan……. Alat hologram…… kuberikan padamu……"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bip… bip… Una trottola nata da una foto… Errore di calcolo… Il mio dispositivo olografico… te lo cedo…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
