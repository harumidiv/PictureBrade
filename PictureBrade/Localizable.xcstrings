          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primul din Cele Cinci Elemente: focul! Mă rotesc până ard de tot!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первая из пяти стихий — огонь! Буду крутиться, пока не сгорю дотла!"
          }
