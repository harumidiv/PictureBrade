          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hegy……megmozdult……!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunungnya…… bergerak……!"
          }
        },
        "it" : {
          "stringUnit" : {
