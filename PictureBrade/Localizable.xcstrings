    "ウーウー！　キミの燃える闘志、消火してやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino-nino! Apagaré el foc del teu esperit de lluita!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húúú-húú! Uhasím tvůj planoucí zápal!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba-bu! Jeg slukker din brændende kampgejst!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatü-tata! Deinen Kampfgeist lösche ich sofort!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νι-νο, νι-νο! Θα σβήσω τη φλογερή σου μαχητικότητα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wee-woo! I'll hose down that burning fighting spirit of yours!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Nii-noo! ¡Voy a apagar tu espíritu de lucha!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuu-tuu! Sammutan palavan taisteluintosi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin-pon ! Je vais éteindre ta flamme de combattant !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वूँ-वूँ! तुम्हारे जोश की आग बुझा दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uuu-uuu! Ugasit ću tvoj vatreni borbeni duh!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viu-viu! Eloltom a lángoló harci kedved!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiu-wiu! Semangat membaramu akan kupadamkan!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni-no-ni-no! Spegnerò il tuo spirito combattivo!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삐뽀삐뽀! 네 불타는 투지, 꺼 주마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiu wiu! Semangat berapi kamu, aku padamkan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba-bu! Jeg slukker den brennende kampgløden din!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatuu tatuu! Die vurige vechtlust van jou, die blus ik wel!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iiijuu! Ugaszę twój płonący zapał!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uiu-uiu! Vou apagar esse seu fogo de lutador!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni-nó, ni-nó! Vou apagar esse teu espírito de luta!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uii-uii! Îți sting eu flacăra luptei!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уи-уу! Сейчас я потушу твой пылающий боевой дух!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húúú-húú! Uhasím tvoj horiaci zápal!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ijo-ijo! Din brinnande stridslust ska jag släcka!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปี๊บป๊าบ! จิตวิญญาณนักสู้ที่ลุกโชนของเธอ จะดับให้เอง!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viyuuu viyuuu! O alev alev yanan savaş ruhunu söndüreceğim!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уі-уу! Зараз погашу твій палкий бойовий запал!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ò e ò e! Ngọn lửa chiến đấu của cậu, để tớ dập tắt cho!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呜——呜——！你熊熊燃烧的斗志，我来帮你灭火！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗚——嗚——！你熊熊燃燒的鬥志，我來幫你滅火！"
          }
        }
      }
    },
