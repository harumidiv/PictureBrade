          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømmen stoppet … Du får denne trommen – la den runge, bom! Pass deg, lenger fremme venter de fem elementenes tegn"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stroming is gestopt… Deze trommel is voor jou. Laat hem lekker dreunen. Pas op: hierna wachten de letters van de vijf elementen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nurt stanął… Weź ten bęben i niech zadudni. Uważaj, dalej czekają znaki pięciu żywiołów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correnteza parou… Te dou este tambor; faça ele ressoar, tum! Cuidado: mais à frente esperam as letras dos cinco elementos"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A corrente parou… Dou-te este tambor; fá-lo ressoar, tum! Cuidado: mais à frente esperam-te as letras dos cinco elementos"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curgerea s-a oprit……Ia toba asta și fă-o să bubuie. Ai grijă, mai departe te așteaptă literele Celor Cinci Elemente."
          }
