    "どっしり構えた山は動かない。押し出せるものなら押し出してみろ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una muntanya ben plantada no es mou. Prova d'empènyer-me fora, si pots!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora stojí neochvějně. Vytlač mě, jestli to dokážeš!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et solidt bjerg flytter sig ikke. Skub mig ud, hvis du kan!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein fest stehender Berg bewegt sich nicht. Schieb mich raus, wenn du kannst!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το βουνό που στέκεται γερά δεν κουνιέται. Σπρώξε με έξω, αν μπορείς!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mountain stands firm and never moves. Push me out if you can!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La montaña firme no se mueve. ¡Sácame del ring si puedes!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vankka vuori ei liikahda. Työnnä minut ulos, jos pystyt!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une montagne bien plantée ne bouge pas. Essaie donc de me pousser dehors !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जमा हुआ पहाड़ हिलता नहीं। धकेल सको तो धकेलकर दिखाओ!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planina stoji čvrsto i ne miče se. Izguraj me ako možeš!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szilárdan álló hegy nem mozdul. Lökj ki, ha tudsz!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung yang kokoh tak akan bergerak. Dorong aku keluar kalau bisa!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una montagna ben piantata non si muove. Prova a spingermi fuori, se ci riesci!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "묵직하게 버틴 산은 움직이지 않는다. 밀어낼 수 있으면 밀어내 봐라!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung yang teguh takkan berganjak. Tolaklah kalau kamu mampu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et solid fjell flytter seg ikke. Skyv meg ut hvis du klarer!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een berg die stevig staat, beweegt niet. Duw me maar weg als je kan!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Góra stoi niewzruszona. Wypchnij mnie, jeśli potrafisz!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A montanha firme não se move. Tente me empurrar para fora, se for capaz!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A montanha firme não se mexe. Empurra-me para fora, se fores capaz!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muntele bine așezat nu se clintește. Încearcă să mă împingi afară, dacă poți!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гора, что стоит прочно, не сдвинется. Попробуй вытолкни, если сможешь!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora stojí neochvejne. Vytlač ma, ak to dokážeš!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett stadigt berg rubbas inte. Knuffa ut mig om du kan!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภูเขาที่ตั้งมั่นไม่มีวันขยับ ผลักออกได้ก็ลองดู!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlam duran dağ kıpırdamaz. İtebiliyorsan it bakalım!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гора стоїть міцно й не зрушить. Спробуй виштовхнути мене, якщо зможеш!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Núi vững chãi thì không lay chuyển. Đẩy được thì cứ đẩy thử xem!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
