        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insegui gli hiragana fuggiti dal Paese dei Bambini fino alla Torre delle Parole a Catena!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어린이 나라에서 튀어나온 히라가나들을 끝말잇기 탑까지 쫓아가라!"
          }
        },
        "ms" : {
