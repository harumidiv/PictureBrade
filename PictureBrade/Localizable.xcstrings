        }
      }
    },
    "「ピコ……ピコ……。地球のコマ、つよすぎる……。おとなしく帰るよ」" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Bip… bip… Les baldufes de la Terra són massa fortes… Me'n torno a casa ben quietet.»"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Píp… píp… Pozemské káči jsou moc silné… Poslušně se vracím domů…“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Bip… bip… Jordens snurretoppe er for stærke… Jeg tager pænt hjem.”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Piep … piep … Die Kreisel der Erde sind zu stark … Ich fliege brav nach Hause.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Μπιπ… μπιπ… Οι σβούρες της Γης είναι πολύ δυνατές… Θα γυρίσω ήσυχα σπίτι μου.»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Beep... boop... Earth tops are way too strong... I'll go home quietly.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bip… bip… Los trompos de la Tierra son demasiado fuertes… Me vuelvo a casa sin protestar.”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Piip… piip… Maan hyrrät ovat liian vahvoja… Lähden kiltisti kotiin.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Bip… bip… Les toupies de la Terre sont trop fortes… Je rentre chez moi bien sagement. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“बीप... बीप... धरती के लट्टू बहुत ताक़तवर हैं... चुपचाप लौट जाता हूँ...”"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Bip… bip… Zemaljske čigre su prejake… Mirno idem kući.«"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pity……pity……. A földi pörgettyűk túl erősek……. Szép csendben hazamegyek.”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Piko……piko……. Gasing Bumi terlalu kuat……. Aku pulang saja deh.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Bip… bip… Le trottole della Terra sono troppo forti… Me ne torno a casa buono buono.»"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“삐코……삐코……. 지구의 팽이, 너무 세……. 얌전히 돌아갈게”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bip... bip... Gasing Bumi terlalu kuat... Aku balik dengan senyap...”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Pip… pip… Jordas snurrebasser er for sterke… Jeg drar pent hjem.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Piep… piep… Aardse tollen zijn veel te sterk… Ik ga braaf naar huis.”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pik… pik… Ziemskie bączki są za mocne… Grzecznie wracam do domu…”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bip… bip… Os piões da Terra são fortes demais… Vou voltar pra casa quietinho.”"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Bip… bip… Os piões da Terra são fortes demais… Vou para casa sem fazer ondas.»"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Pic……pic……Titirezele Pământului sunt prea puternice……Mă duc acasă cuminte.»"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Пик……пик……. Земные волчки слишком сильные……. Ладно, улетаю домой»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Píp… píp… Pozemské vĺčiky sú pridobré… Poslušne idem domov…“"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Pip… pip… Jordens snurror är för starka… Jag åker snällt hem.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ปิ๊บ……ปิ๊บ…… ลูกข่างโลก แข็งแกร่งเกินไป…… จะกลับบ้านดีๆ แล้ว”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bip... bip... Dünya topaçları çok güçlü... Uslu uslu evime dönüyorum.”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Пі-ку… пі-ку… Земні дзиґи надто сильні… Гаразд, лечу додому»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Píp……píp……. Con quay Trái Đất mạnh quá……. Tớ ngoan ngoãn về nhà đây”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“哔……哔……地球的陀螺，太强了……我乖乖回去就是了。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「嗶……嗶……地球的陀螺，太強了……我乖乖回去就是了。」"
          }
        }
      }
    },
