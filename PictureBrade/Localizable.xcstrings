    "流れ星に願いごと？　そんなひまは与えない！　一瞬で燃え尽きろ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demanar un desig a un estel fugaç? No hi ha temps! Consumeix-te en un instant!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přání padající hvězdě? Na to ti nedám čas! Shoř v mžiku!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ønske dig noget ved et stjerneskud? Det har du ikke tid til! Brænd op på et øjeblik!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wunsch an die Sternschnuppe? Dafür lass ich dir keine Zeit! Verglüh im Nu!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευχή σε πεφταστέρι; Δεν σου αφήνω χρόνο! Κάψου σε μια στιγμή!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a wish on a shooting star? I won't give you the time! Burn out in a flash!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Pedirle un deseo a una estrella fugaz? ¡No te daré tiempo! ¡Arde en un instante!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toive tähdenlennolle? Siihen ei ole aikaa! Pala loppuun hetkessä!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire un vœu sur une étoile filante ? Pas le temps ! Consume-toi en un éclair !"
          }
