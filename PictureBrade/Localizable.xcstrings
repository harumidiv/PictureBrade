    "ばたんきゅう……。最後は丸をつけた「ぱ」が待ってる" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba-bum… K.O.… L'última és la «ぱ», la del redolinet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padám únavou… Na konci čeká „ぱ“ s kroužkem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knock-out… Til sidst venter ”ぱ” med den lille ring"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plumps … k.o. … Zum Schluss wartet „ぱ“ mit dem Kringel"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατέρρευσα… Στο τέλος σε περιμένει το «ぱ» με το κυκλάκι"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down and out... Last up is “ぱ”, the one with the little circle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me rindo… Al final te espera la “ぱ”, la del circulito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyrmätty… Lopuksi odottaa renkaallinen ”ぱ”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba-boum… K.-O… Le dernier, c'est « ぱ », celui avec un petit rond."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढेर हो गया... आख़िर में गोला लगाए “ぱ” इंतज़ार कर रहा है"
          }
        },
