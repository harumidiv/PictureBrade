        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa-pa-ra-paaam! Niente puntini per me, ma un cerchietto: ecco a voi la «ぱ» speciale! Il suono «pop!» che scoppia è il mio tesoro!"
