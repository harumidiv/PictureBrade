    "8つに切り分けたピースのように、キミのコマも切り分けてやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com una pizza tallada en vuit trossos, també tallaré la teva baldufa!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozkrájím tvou káču na kousky jako pizzu na 8 dílků!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligesom en pizza i otte stykker skærer jeg også din top i stykker!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie eine Pizza in acht Stücke – so zerteile ich auch deinen Kreisel!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαν πίτσα κομμένη σε 8 κομμάτια, θα κομματιάσω και τη σβούρα σου!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll slice your top up into eight pieces, just like me!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Te voy a cortar en ocho porciones, igual que a mí!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuin kahdeksaan palaan leikattu pizza – leikkaan hyrräsikin paloiksi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme une pizza en huit parts, je vais découper ta toupie en morceaux !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिज़्ज़ा के आठ टुकड़ों की तरह, तुम्हारे लट्टू के भी टुकड़े कर दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narezat ću tvoju čigru kao pizzu na osam komada!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahogy a pizzát nyolc szeletre vágják, úgy vágom szét a pörgettyűdet is!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti pizza yang dipotong 8, gasingmu juga akan kupotong-potong!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come una pizza tagliata in otto spicchi, affetterò anche la tua trottola!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여덟 조각으로 자른 피자처럼, 네 팽이도 조각내 주마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macam piza dipotong lapan, gasing kamu pun aku potong-potong!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkurat som en pizza i åtte biter, deler jeg snurrebassen din i biter!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik snij jouw tol in stukken, net als een pizza in acht punten!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokroję twojego bączka na kawałki jak pizzę na 8 części!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou cortar seu pião em oito fatias, igualzinho a mim!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou cortar o teu pião em oito fatias, tal como eu!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te tai felii ca pe o pizza în opt bucăți!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как пиццу на 8 кусочков, я нарежу и твой волчок!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozkrájam tvojho vĺčika na kúsky ako pizzu na 8 dielikov!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som en pizza i åtta bitar ska jag skära din snurra i bitar!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือนพิซซ่าที่หั่นเป็น 8 ชิ้น ข้าจะหั่นลูกข่างของเจ้าด้วย!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekiz dilime bölünmüş bir pizza gibi, senin topacını da dilim dilim edeceğim!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наріжу твою дзиґу, як піцу на вісім шматочків!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Như chiếc bánh cắt thành 8 miếng, ta sẽ xẻ con quay của ngươi ra!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就像切成8块的披萨一样，我也要把你的陀螺切开！"
          }
