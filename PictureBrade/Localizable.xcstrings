    "コマをタップすると装備を変えられます。右上の「編集」か、コマの長押しで削除できます" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una baldufa per canviar-ne l'equipament. Per esborrar-la, toca «Editar» a dalt a la dreta o mantén-la premuda"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na káču změníš vybavení. Smazat ji můžeš tlačítkem „Upravit“ vpravo nahoře nebo podržením káči"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en top for at skifte udstyr. Slet med ”Redigér” øverst til højre, eller hold fingeren på en top"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Kreisel, um seine Ausrüstung zu ändern. Löschen geht über „Bearbeiten“ oben rechts oder durch langes Drücken"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα μια σβούρα για να αλλάξεις εξοπλισμό. Για διαγραφή, πάτα «Επεξεργασία» πάνω δεξιά ή κράτα πατημένη τη σβούρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a top to change its equipment. Delete with \"Edit\" at the top right, or by long-pressing a top"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un trompo para cambiar su equipo. Para eliminarlo, usa “Editar” arriba a la derecha o mantenlo pulsado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta hyrrää vaihtaaksesi varusteita. Poista oikean yläkulman ”Muokkaa”-painikkeella tai pitämällä sormea hyrrän päällä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche une toupie pour changer son équipement. Pour la supprimer, touche « Modifier » en haut à droite ou appuie longuement dessus"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लट्टू पर टैप करके इक्विपमेंट बदलो। ऊपर दाईं ओर “एडिट” से या लट्टू को देर तक दबाकर हटा सकते हो"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni čigru da promijeniš opremu. Briši pomoću „Uredi“ gore desno ili dugim pritiskom na čigru"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints egy pörgettyűre a felszerelés cseréjéhez. A jobb felső „Szerkesztés” gombbal vagy hosszú nyomással törölheted"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk gasing untuk mengganti perlengkapan. Hapus lewat “Edit” di kanan atas atau tekan lama gasingnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una trottola per cambiarne l'equipaggiamento. Per eliminarla, tocca «Modifica» in alto a destra o tienila premuta"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팽이를 탭하면 장착을 바꿀 수 있어요. 오른쪽 위 “편집”이나 팽이를 길게 눌러 삭제할 수 있어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik gasing untuk menukar kelengkapan. Padam melalui “Edit” di atas kanan, atau tekan lama gasing"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en snurrebass for å bytte utstyr. Slett med «Rediger» øverst til høyre, eller hold fingeren på en snurrebass"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een tol om de uitrusting te wijzigen. Verwijderen kan via “Wijzig” rechtsboven of door een tol ingedrukt te houden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij bączka, aby zmienić wyposażenie. Usuniesz go przyciskiem „Edytuj” w prawym górnym rogu lub przytrzymując bączka"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um pião para trocar o equipamento. Para excluir, use “Editar” no canto superior direito ou toque e segure o pião"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num pião para mudar o equipamento. Para o eliminar, usa «Editar» no canto superior direito ou mantém o pião premido"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge un titirez ca să-i schimbi echipamentul. Îl ștergi cu „Editează” din dreapta sus sau ținând apăsat pe el"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми на волчок, чтобы сменить снаряжение. Удалить можно кнопкой «Изменить» справа вверху или долгим нажатием на волчок"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknutím na vĺčika zmeníš výbavu. Vymazať ho môžeš tlačidlom „Upraviť“ vpravo hore alebo podržaním vĺčika"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en snurra för att byta utrustning. Radera med ”Redigera” uppe till höger eller genom att hålla inne en snurra"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะลูกข่างเพื่อเปลี่ยนอุปกรณ์ ลบได้ด้วยปุ่ม “แก้ไข” มุมขวาบน หรือกดค้างที่ลูกข่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir topaca dokunarak ekipmanını değiştir. Sağ üstteki “Düzenle” ile ya da topaca uzun basarak silebilirsin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкнись дзиґи, щоб змінити спорядження. Видалити можна через «Редагувати» вгорі праворуч або довгим натисканням на дзиґу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào con quay để đổi trang bị. Xóa bằng nút “Sửa” ở góc trên bên phải hoặc nhấn giữ con quay"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击陀螺即可更换装备。点击右上角的“编辑”或长按陀螺即可删除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下陀螺即可更換裝備。點一下右上角的「編輯」或長按陀螺即可刪除"
          }
        }
      }
    },
