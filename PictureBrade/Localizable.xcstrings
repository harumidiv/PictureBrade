            "value" : "Αν υπήρχε μια τρύπα… θα κρυβόμουν μέσα… α, έχω ήδη μία…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I wish I could crawl into a hole... oh wait, I already have one..."
          }
        },
        "es" : {
          "stringUnit" : {
