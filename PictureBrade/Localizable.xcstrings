    "あはははは！　笑いが止まらない！　回転も止まらないぞ〜！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha ha! No puc parar de riure! I tampoc no puc parar de girar!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chachachacha! Nemůžu se přestat smát! A točit se taky nepřestanu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! Jeg kan ikke stoppe med at grine! Og jeg kan heller ikke stoppe med at snurre!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Ich kann nicht aufhören zu lachen! Und mit dem Drehen auch nicht~!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαχαχαχα! Δεν μπορώ να σταματήσω να γελάω! Ούτε να γυρίζω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahahaha! I can't stop laughing! And I can't stop spinning either~!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ja, ja, ja, ja! ¡No puedo parar de reír! ¡Y tampoco de girar!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! En voi lopettaa nauramista! Enkä pyörimistäkään!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha ha ! Impossible d'arrêter de rire ! Et impossible d'arrêter de tourner !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अहाहाहा! हँसी रुक ही नहीं रही! घूमना भी नहीं रुकेगा~!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Ne mogu prestati se smijati! A ni vrtjeti!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Nem bírom abbahagyni a nevetést! És a pörgést sem~!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! Tawaku nggak bisa berhenti! Putaranku juga nggak bakal berhenti~!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah ah ah ah! Non riesco a smettere di ridere! E nemmeno di girare!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아하하하하! 웃음이 멈추질 않아! 회전도 멈추지 않는다~!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! Tak boleh berhenti ketawa! Putaran pun tak berhenti~!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! Jeg klarer ikke å slutte å le! Og jeg klarer ikke å slutte å snurre heller!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Ik kan niet stoppen met lachen! En met draaien ook niet~!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Nie mogę przestać się śmiać! I kręcić też nie przestanę!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha ha! Não consigo parar de rir! E nem de girar!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah ah ah ah! Não consigo parar de rir! Nem de girar!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha-ha-ha-ha! Nu mă pot opri din râs! Nici din învârtit!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ха-ха-ха-ха! Не могу перестать смеяться! И крутиться тоже не перестану~!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chachachacha! Nemôžem sa prestať smiať! A točiť sa tiež neprestanem!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahahaha! Jag kan inte sluta skratta! Och inte sluta snurra heller!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ๊ะฮ่าฮ่าฮ่า! หัวเราะไม่หยุดเลย! การหมุนก็ไม่หยุดด้วย~!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahahaha! Gülmem durmuyor! Dönüşüm de durmuyor!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ха-ха-ха! Не можу перестати сміятися! І крутитися теж не перестану!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha ha! Cười không dừng được! Quay cũng không dừng luôn~!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啊哈哈哈哈！笑得停不下来！旋转也停不下来～！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啊哈哈哈哈！笑得停不下來！旋轉也停不下來～！"
          }
        }
