        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum sempat merebak... dah dipadam..."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slukket … før jeg rakk å spre meg …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedoofd… voordat ik kon uitbreiden…"
