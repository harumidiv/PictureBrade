    "Game Center にサインインすると、ランキングと実績に参加できます" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessió a Game Center per participar a les classificacions i als assoliments"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se do Game Center a zapoj se do žebříčku a úspěchů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på Game Center for at være med på ranglisten og få præstationer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei Game Center an, um bei Bestenlisten und Erfolgen mitzumachen"
