    "ストーリーで章のボスを倒すと、新しい報酬が手に入る！（%lld/%lld）" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrota els caps de capítol al mode Història per guanyar noves recompenses! (%lld/%lld)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poraz v Příběhu bosse kapitoly a získej nové odměny! (%lld/%lld)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besejr kapitlets boss i Historie for at få nye belønninger! (%lld/%lld)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besiege in der Story die Kapitel-Bosse, um neue Belohnungen zu bekommen! (%lld/%lld)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νίκησε τα αφεντικά των κεφαλαίων στην Ιστορία για νέες ανταμοιβές! (%lld/%lld)"
          }
        },
        "en" : {
          "stringUnit" : {
