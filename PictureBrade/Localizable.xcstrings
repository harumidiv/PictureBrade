    "残像が見えるほど速く、長く回る" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira tan ràpid que deixa rastre, i molta estona"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak rychlé, že zanechává šmouhy, a točí se dlouho"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snurrer så hurtigt og længe, at man ser efterbilleder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So schnell, dass man Nachbilder sieht – und lange drehend"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γυρίζει τόσο γρήγορα που αφήνει είδωλα — και για πολλή ώρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spins so fast and long it leaves afterimages"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira tan rápido y tanto tiempo que deja estela"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyörii niin nopeasti ja pitkään, että näkyy jälkikuvia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne si vite qu'on voit des images fantômes, et longtemps"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतना तेज़ कि परछाइयाँ दिखें, और देर तक घूमे"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrti se tako brzo i dugo da ostaje trag"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olyan gyorsan és sokáig pörög, hogy utóképet hagy"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berputar cepat dan lama sampai ada bayangannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira così veloce da lasciare la scia, e a lungo"
