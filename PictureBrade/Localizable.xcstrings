        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα emoji ρουφήχτηκαν ένα-ένα μέσα στον δίσκο και γύρισαν στο διάστημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
