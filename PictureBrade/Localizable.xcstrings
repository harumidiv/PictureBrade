          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua puluh sembilan garis... Tulislah kalau boleh. Kerumitan inilah bukti aku paling kuat..."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "29 streker … skriv meg om du kan. Denne kompleksiteten er beviset på at jeg er sterkest …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negenentwintig streepjes… schrijf me maar eens na. Deze complexiteit is het bewijs dat ik de sterkste ben…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwadzieścia dziewięć kresek… Napisz mnie, jeśli potrafisz. Ta złożoność to dowód mojej siły…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte e nove traços… escreva-me, se for capaz. Esta complexidade é a prova de que sou o mais forte…"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte e nove traços… escreve-me, se fores capaz. Esta complexidade é a prova de que sou o mais forte…"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Douăzeci și nouă de trăsături……scrie-mă dacă poți. Complicația asta e dovada că sunt cel mai puternic……"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двадцать девять черт……напиши меня, если сможешь. Эта сложность — доказательство моей силы……"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvadsaťdeväť ťahov… Napíš ma, ak to dokážeš. Táto zložitosť je dôkazom sily…"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjugonio streck… skriv mig om du kan. Denna komplexitet är beviset på min styrka…"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยี่สิบเก้าขีด……เขียนได้ก็ลองเขียนดู ความซับซ้อนนี้คือเครื่องพิสูจน์ความแกร่งที่สุด……"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yirmi dokuz çizgi... yazabiliyorsan yaz bakalım. Bu karmaşıklık en güçlü olmanın kanıtıdır..."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двадцять дев'ять рисок… Спробуй-но мене написати. Ця складність — доказ моєї сили…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mươi chín nét……viết được thì viết thử xem. Sự phức tạp này chính là bằng chứng của kẻ mạnh nhất……"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二十九画……有本事就写写看。这份复杂，正是最强的证明……"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二十九畫……有本事就寫寫看。這份複雜，正是最強的證明……"
          }
        }
      }
    },
    "五行の一番手、火！　燃え尽きるまで回り続けてやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer dels cinc elements: el foc, «火»! Giraré fins a consumir-me!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "První z pěti živlů — oheň! Budu se točit, dokud nevyhořím!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den første af de fem elementer: ild! Jeg snurrer, til jeg brænder ud!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erste der fünf Elemente: Feuer! Ich drehe mich, bis ich ausgebrannt bin!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρώτη από τα Πέντε Στοιχεία: η Φωτιά! Θα γυρίζω μέχρι να γίνω στάχτη!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First of the Five Elements: Fire! I'll keep spinning until I burn out!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡El primero de los cinco elementos: el fuego, “火”! ¡Giraré hasta consumirme!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viiden elementin ensimmäinen: tuli! Pyörin, kunnes palan loppuun!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier des cinq éléments : le feu, « 火 » ! Je vais tourner jusqu'à me consumer !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंचतत्व का पहला योद्धा, आग! जलकर राख होने तक घूमता रहूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvi od pet elemenata — vatra! Vrtjet ću se dok ne izgorim!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az öt elem első tagja, a tűz! Addig pörgök, amíg el nem égek!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang pertama dari lima unsur, api! Aku akan terus berputar sampai habis terbakar!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo dei cinque elementi: il fuoco, «火»! Girerò finché non mi consumo!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오행의 선봉, 불! 다 타 버릴 때까지 계속 돌아 주마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertama dalam Lima Unsur, Api! Aku akan terus berputar sampai hangus terbakar!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den første av de fem elementene: ild! Jeg snurrer til jeg brenner ut!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste van de vijf elementen: vuur! Ik blijf draaien tot ik helemaal opgebrand ben!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy z pięciu żywiołów — ogień! Będę wirował, aż się wypalę!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro dos cinco elementos: o fogo, “火”! Vou girar até virar cinzas!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
