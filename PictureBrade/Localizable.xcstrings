    "バトルで勝つとポイントがたまる！（負けてもちょっとだけもらえる）" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guanya combats per acumular punts! (Encara que perdis, en guanyes uns quants)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhrávej zápasy a sbírej body! (I za prohru trochu dostaneš)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind kampe for at samle point! (Du får også lidt, hvis du taber)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewinne Kämpfe, um Punkte zu sammeln! (Auch bei Niederlagen gibt’s ein paar)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κέρδισε μάχες για να μαζέψεις πόντους! (Και στην ήττα παίρνεις λίγους)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win battles to earn points! (You get a few even if you lose)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gana batallas para acumular puntos! (si pierdes, también recibes unos pocos)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voita otteluita ja kerää pisteitä! (Häviöstäkin saa vähän)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagne des combats pour cumuler des points ! (Même en perdant, tu en gagnes un peu)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुक़ाबले जीतो और पॉइंट जमा करो! (हारने पर भी थोड़े मिलते हैं)"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobjedama skupljaš bodove! (I za poraz dobiješ malo)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Győzz a csatákban, és gyűlnek a pontok! (Vereségért is jár egy kevés)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menang pertarungan untuk kumpulkan poin! (kalah pun dapat sedikit)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinci gli incontri per accumulare punti! (Anche se perdi, ne ricevi qualcuno)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배틀에서 이기면 포인트가 쌓여! (져도 조금은 받을 수 있어)"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menang pertarungan untuk kumpul mata! (Kalah pun dapat sedikit)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinn kamper for å samle poeng! (Du får litt selv om du taper)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win gevechten om punten te sparen! (Ook bij verlies krijg je er een paar)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygrywaj walki, aby zbierać punkty! (Za przegraną też trochę dostaniesz)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vença batalhas para acumular pontos! (perdendo, você também ganha um pouquinho)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganha batalhas para acumulares pontos! (se perderes, também recebes um bocadinho)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câștigi bătălii și aduni puncte! (chiar și când pierzi primești puțin)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Побеждай в боях и копи очки! (Даже за поражение немного дают)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhrávaj zápasy a zbieraj body! (Aj za prehru trochu dostaneš)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinn strider för att samla poäng! (Du får lite även om du förlorar)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชนะการต่อสู้เพื่อสะสมแต้ม! (แพ้ก็ได้นิดหน่อย)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savaş kazanarak puan topla! (Kaybetsen de biraz puan alırsın)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемагай у боях і збирай очки! (Навіть за поразку трохи дають)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thắng trận để tích điểm! (thua cũng được một chút)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赢得对战就能累积点数！（输了也能拿到一点点）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贏得對戰就能累積點數！（輸了也能拿到一點點）"
          }
        }
      }
    },
