    "……何者かが近づいてくる。" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Algú s'acosta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Někdo se blíží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Nogen nærmer sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Jemand kommt näher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Κάποιος πλησιάζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...Someone is approaching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Alguien se acerca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Joku lähestyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Quelqu'un approche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...कोई पास आ रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Netko se približava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……Valaki közeledik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……Ada sesuatu yang mendekat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… Qualcuno si sta avvicinando."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……누군가 다가온다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...Ada sesuatu sedang menghampiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Noen nærmer seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Er komt iemand aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Ktoś się zbliża."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Alguém está se aproximando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Alguém se aproxima."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……Cineva se apropie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……Кто-то приближается."
          }
        },
        "sk" : {
          "stringUnit" : {
