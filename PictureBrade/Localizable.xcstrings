    "こどもの国から飛び出したひらがなたちを、しりとりの塔まで追いかけろ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persegueix els hiragana escapats del País dels Infants fins a la Torre de les Paraules Encadenades!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronásleduj hiraganu, která utekla z Dětské říše, až k Věži slovního fotbalu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagt hiraganaerne fra Børnelandet hele vejen til Ordkædetårnet!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag die Hiragana aus dem Kinderland bis zum Wortketten-Turm!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κυνήγησε τα χιραγκάνα που ξέφυγαν από τη Χώρα των Παιδιών ως τον Πύργο της Λεξοαλυσίδας!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chase the hiragana that fled Kids' Land all the way to the Word Chain Tower!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Persigue a los hiraganas que escaparon del País de los Niños hasta la Torre de Palabras Encadenadas!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahtaa Lasten maasta karanneita hiraganoita Sanaketjutorniin asti!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poursuis les hiragana échappés du Pays des Enfants jusqu'à la Tour des Mots en Chaîne !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बच्चों के देश से भागे हिरागाना का पीछा करो, शब्द-श्रृंखला मीनार तक!"
