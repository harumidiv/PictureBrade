    "め、目が回る〜。「ぬ」ちゃんは手ごわいわよ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E… em roda el cap… Compte, que la «ぬ» és dura de pelar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T-točí se mi hlava… Pozor, „ぬ“ je tvrdý oříšek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J-jeg er helt svimmel… ”ぬ” er en hård nød, skal jeg sige dig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M-mir ist schwindelig~. „ぬ“ ist echt hart, sag ich dir"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζ-ζαλίστηκα~. Η μικρή «ぬ» είναι σκληρό καρύδι"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My eyes— er, my “め”— they're spinning~. Watch out, “ぬ” is a tough one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Q-qué mareo… La “ぬ” es dura de pelar, ¿eh?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M-minua huimaa… ”ぬ” on kova pähkinä, kerron vain"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M… mes yeux tournent… Fais gaffe, « ぬ » est coriace, tu sais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "च-चक्कर आ रहे हैं~। “ぬ” बहुत कड़ी है, सावधान"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V-vrti mi se… „ぬ“ je opaka, pazi!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sz-szédülök~. A „ぬ” kemény ellenfél ám"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-pusing~. Si “ぬ” itu tangguh, lho"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M… mi gira la testa… Occhio, «ぬ» è un osso duro, sai."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누, 눈이 돌아~. “ぬ”는 만만치 않을걸"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-pening~. Si “ぬ” tu susah dilawan tau"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J-jeg er helt svimmel … «ぬ» er en tøff nøtt, skal du vite"
          }
        },
        "nl" : {
