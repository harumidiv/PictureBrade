    "にっこり。笑顔で回るよ。でも、目は笑ってないかもね？" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somrient, somrient, giro. Però potser els meus ulls no somriuen, eh?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsměv! Točím se s úsměvem. Ale oči se možná vůbec nesmějí…?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smil! Jeg snurrer med et stort smil. Men mine øjne smiler måske ikke?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lächel-lächel. Ich drehe mich mit einem Grinsen. Aber meine Augen lachen vielleicht nicht mit …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμογελάκι. Γυρίζω με χαμόγελο. Αλλά τα μάτια μου ίσως δεν γελάνε, ε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smile! I spin with a big grin. But maybe my eyes aren't smiling...?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrío y giro. Aunque puede que mis ojos no sonrían, ¿eh?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hymyä! Pyörin iloisesti hymyillen. Mutta silmäni eivät ehkä hymyile?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout sourire, je tourne. Mais mes yeux, eux, ne sourient peut-être pas…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुस्कुराते हुए घूमता हूँ। पर शायद मेरी आँखें नहीं मुस्कुरा रहीं, हैं ना?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smijem se i vrtim. Ali možda mi se oči ne smiju, hm?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosoly. Mosolyogva pörgök. De lehet, hogy a szemem nem mosolyog, ki tudja?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senyum. Aku berputar sambil tersenyum. Tapi mungkin mataku nggak ikut tersenyum, lho?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorridendo sorridendo, giro. Ma i miei occhi, forse, non sorridono…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방긋. 웃는 얼굴로 돌아 줄게. 근데 눈은 안 웃고 있을지도?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senyum. Aku berputar sambil tersenyum. Tapi mata aku mungkin tak senyum, tau?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smil! Jeg snurrer med et stort smil. Men øynene mine smiler kanskje ikke?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smile. Ik draai met een glimlach. Maar lachen mijn ogen ook mee?"
          }
        },
        "pl" : {
