    "空から獲物を狙う鷹の目からは、逃げられない" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningú no escapa de l'ull del falcó que vigila la presa des del cel."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před okem jestřába, který loví z nebe, neutečeš"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke flygte fra høgens øjne, der jager fra himlen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Auge des Falken, der vom Himmel aus jagt, entkommst du nicht"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από το μάτι του γερακιού που κυνηγά από ψηλά δεν ξεφεύγεις"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no escaping the eyes of the hawk, hunting from the sky"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escaparás de la mirada del halcón, que caza desde el cielo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taivaalta saalistavan haukan silmiltä et pääse pakoon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n'échappe à l'œil du faucon qui guette sa proie depuis le ciel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आसमान से शिकार ताकती बाज़ की नज़र से कोई नहीं बचता"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od očiju jastreba koji s neba vreba plijen nema bijega."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sólyom szeme a magasból les a zsákmányra: előle nincs menekvés"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak ada yang lolos dari mata elang yang mengincar mangsa dari langit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno sfugge all'occhio del falco che punta la preda dal cielo."
