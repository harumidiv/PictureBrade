    "チリンチリン！　ペダルをこいで、ぐるぐる回るよ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring ring! Pedalo i giro en rodona!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crrr-crrr! Šlapu do pedálů a točím se dokola!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kling-kling! Jeg træder i pedalerne og drøner rundt og rundt!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kling-kling! Ich trete in die Pedale und drehe Runde um Runde!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ντριν-ντριν! Κάνω πετάλι και γυρίζω, γυρίζω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring-ring! Pedaling hard, round and round I go!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ring, ring! ¡Pedaleo y giro sin parar!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kling kling! Poljen pedaaleja ja kiidän ympäri ja ympäri!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dring dring ! Je pédale et je tourne en rond !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
