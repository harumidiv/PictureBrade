    "絵文字たちがのこしていったふしぎな道具は、キミのフォトブレードの宝物になった。" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els estris misteriosos que van deixar els emojis s'han convertit en els tresors de la teva Photo Blade."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záhadné vychytávky, které emoji zanechala, se staly pokladem tvého Photo Blade."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De mystiske dimser, emojierne efterlod, blev til skatte for din Photo Blade."
