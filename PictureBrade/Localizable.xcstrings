    "キミのフォトブレードで、ひらがなたちをこどもの国へ帰して、おもちゃ箱の宝物を取り戻そう！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la teva Photo Blade, torna els hiragana al País dels Infants i recupera els tresors del bagul de joguines!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošli svým Photo Blade hiraganu zpátky do Dětské říše a získej zpět poklady z krabice s hračkami!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send hiraganaerne hjem til Børnelandet med din Photo Blade, og få legetøjskassens skatte tilbage!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick die Hiragana mit deinem Photo Blade zurück ins Kinderland und hol dir die Schätze der Spielzeugkiste zurück!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τη Photo Blade σου, στείλε τα χιραγκάνα πίσω στη Χώρα των Παιδιών και πάρε πίσω τους θησαυρούς του κουτιού με τα παιχνίδια!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your Photo Blade to send the hiragana home to Kids' Land and win back the toy box treasures!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Usa tu Photo Blade para devolver a los hiraganas al País de los Niños y recupera los tesoros del baúl de juguetes!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta hiraganat Lasten maahan Photo Bladellasi ja hae lelulaatikon aarteet takaisin!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ta Photo Blade, renvoie les hiragana au Pays des Enfants et récupère les trésors du coffre à jouets !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Photo Blade से हिरागाना को बच्चों के देश वापस भेजो और खिलौनों के डिब्बे का ख़ज़ाना वापस लाओ!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svojim Photo Bladeom vrati hiragana slova u Dječju zemlju i spasi blago iz kutije s igračkama!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Bladeddel küldd vissza a hiraganákat Gyerekországba, és szerezd vissza a játékosláda kincseit!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Photo Blade-mu, pulangkan para hiragana ke Negeri Anak-Anak dan rebut kembali harta karun kotak mainan!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la tua Photo Blade, riporta gli hiragana al Paese dei Bambini e recupera i tesori della cesta dei giocattoli!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네 Photo Blade로 히라가나들을 어린이 나라로 돌려보내고, 장난감 상자의 보물을 되찾자!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Photo Blade kamu, hantar hiragana pulang ke Negeri Kanak-kanak dan dapatkan semula harta kotak mainan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send hiraganaene hjem til Barnas land med din Photo Blade, og få tilbake skattene fra lekekassa!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur de hiragana met je Photo Blade terug naar het Kinderland en haal de schatten uit de speelgoedkist terug!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoim Photo Blade odeślij hiragany do Krainy Dzieci i odzyskaj skarby z pudła z zabawkami!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use seu Photo Blade para levar os hiraganas de volta à Terra das Crianças e recupere os tesouros do baú de brinquedos!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o teu Photo Blade para levar os hiraganas de volta à Terra das Crianças e recupera os tesouros da caixa de brinquedos!"
          }
        },
        "ro" : {
          "stringUnit" : {
