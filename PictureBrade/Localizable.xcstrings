    "あ……あっけなかった……。次の「い」はまっすぐな子よ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A… ai, que ràpid que ha anat… La següent, la «い», és una noia molt recta."
          }
        },
        "cs" : {
