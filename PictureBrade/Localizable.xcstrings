    "小さい「ゃ」！　ボクがつくと「き」が「きゃ」になるんだ。小さいからってなめないでよね！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La «ゃ» petita! Amb mi, «ki» es torna «kya». Soc petita, però no em subestimis!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malé „ゃ“! Když se přidám, „ki“ se změní na „kja“. Nepodceňuj mě, že jsem malá!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lille ”ゃ”! Når jeg kommer med, bliver ”き” til ”kya”. Undervurdér mig ikke, bare fordi jeg er lille!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kleine „ゃ“! Mit mir wird aus „き“ ein „kya“. Nur weil ich klein bin, unterschätz mich nicht!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μικρό «ゃ»! Όταν μπαίνω δίπλα στο «き», γίνεται «kya»! Μη με υποτιμάς επειδή είμαι μικρό!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Little “ゃ”! When I tag along, \"ki\" becomes \"kya\"! Don't look down on me just 'cause I'm small!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Soy la “ゃ” pequeña! Si me pongo al lado, la “ki” se vuelve “kya”. ¡Que sea pequeña no significa que puedas subestimarme!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieni ”ゃ”! Kun tulen mukaan, ”き” muuttuu ”kya”:ksi. Älä aliarvioi minua, vaikka olen pieni!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le petit « ゃ » ! Avec moi, « ki » devient « kya ». Je suis petit, mais ne me sous-estime pas !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा “ゃ”! मैं जुड़ते ही ki बन जाता है kya! छोटा हूँ तो क्या, कम मत समझना!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali „ゃ“! Kad stanem uz „き“, nastaje „kya“. Nemoj me podcjenjivati jer sam malen!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kis „ゃ”! Ha mellém kerülsz, a „き”-ből „kja” lesz. Attól, hogy kicsi vagyok, ne nézz le!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ゃ” kecil! Kalau aku menempel, “ki” jadi “kya”. Jangan remehkan aku karena kecil, ya!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La piccola «ゃ»! Con me, «ki» diventa «kya». Sarò piccola, ma non sottovalutarmi!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 “ゃ”! 내가 붙으면 “き”가 “kya(캬)”가 되지. 작다고 얕보지 마!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ゃ” kecil! Bila aku melekat, ki jadi kya! Jangan pandang rendah sebab aku kecil!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liten «ゃ»! Når jeg er med, blir «き» til «kya». Ikke undervurder meg bare fordi jeg er liten!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine “ゃ”! Met mij erbij wordt “き” “kya”. Denk maar niet dat klein zwak betekent!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe „ゃ”! Gdy się dopiszę, „ki” zmienia się w „kya”. Nie lekceważ mnie, że jestem mała!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou o “ゃ” pequeno! Se eu fico do lado, o “ki” vira “kya”. Não é porque sou pequeno que você pode me subestimar!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou o «ゃ» pequeno! Se me puser ao lado, o «ki» passa a «kya». Não é por ser pequeno que me podes subestimar!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt micuțul „ゃ”! Când mă lipesc de „き” (ki), devine „kya”! Nu mă subestima că-s mic!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленькая «ゃ»! Со мной «き» становится «kya». Не смотри свысока, что я маленькая!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malé „ゃ“! Keď sa pridám, „ki“ sa zmení na „kja“. Nepodceňuj ma, že som malá!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilla ”ゃ”! Med mig blir ”き” till ”kya”. Underskatta mig inte bara för att jag är liten!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ゃ” ตัวเล็ก! ถ้ามีฉัน “き” จะกลายเป็น “kya” ตัวเล็กก็อย่าดูถูกนะ!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük “ゃ”! Ben eklenince “き” (ki), “kya” olur. Küçüğüm diye beni hafife alma!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я мала «ゃ»! З «き» я роблю «кя». Не дивись, що я маленька!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ゃ” nhỏ đây! Có tớ, “き” sẽ thành “kya”. Nhỏ thì sao, đừng coi thường nhé!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小小的“ゃ”！有我跟着，“ki”就会变成“kya”。可别因为我小就小看我！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小小的「ゃ」！有我跟著，「ki」就會變成「kya」。可別因為我小就小看我！"
          }
        }
      }
    },
