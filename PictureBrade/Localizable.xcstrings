    "めったに出番のない「ぁ」。「ふぁいと！」のときくらいしか呼ばれないけど、実力は本物さ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La «ぁ», gairebé no em criden mai. Només per escriure «faito!» («fight!»), però la meva força és ben real!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„ぁ“ se moc často neukáže. Volají mě skoro jen ve „faito!“ (to je „fight!“), ale síla je skutečná"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”ぁ” kommer sjældent på banen. Jeg bliver kun kaldt frem til ord som ”fa-ito!” (kæmp!), men mine kræfter er ægte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das „ぁ“ ist selten dran. Man ruft mich fast nur bei „fa-i-to!“ (Fight!), aber stark bin ich trotzdem"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «ぁ» σπάνια βγαίνει στη σκηνή. Με φωνάζουν μόνο σε κανένα «fa-ito!» (κουράγιο!), αλλά η δύναμή μου είναι αληθινή"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm “ぁ”, and I hardly ever get to show up. About the only time I'm called is in \"fa-i-to!\" (fight!), but my skills are the real deal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi nunca salgo, la “ぁ”. Solo me llaman para escribir cosas como “fight” en japonés, ¡pero mi fuerza es de verdad!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”ぁ” pääsee harvoin esiin. Minua kutsutaan vain sellaisiin sanoihin kuin ”fa-ito!” (taistele!), mutta voimani ovat aitoja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« ぁ », on m'appelle rarement. À peine pour écrire « faito ! » (« fight ! »), mais ma force, elle, est bien réelle !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम ही मौक़ा पाने वाला “ぁ”। बस “faito!” (फ़ाइट!) में बुलाया जाता हूँ, पर ताक़त असली है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rijetko me trebaju, ja sam „ぁ“. Zovu me tek kad netko vikne „faito!“, ali snaga mi je prava!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ritkán szereplő „ぁ”. Csak olyankor hívnak, mint a „fáito!” (hajrá!), de az ereje valódi"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ぁ” yang jarang tampil. Cuma dipanggil buat seruan “fight!”, tapi kemampuanku asli, lho"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«ぁ», mi chiamano di rado. Giusto per scrivere «faito!» («fight!»), ma la mia forza è vera!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좀처럼 나설 일이 없는 “ぁ”. “fa-ito(파이토)!” 할 때나 불리지만, 실력은 진짜라고"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku “ぁ”, jarang dapat giliran. Cuma dipanggil masa “faito!” (fight!), tapi kuasa aku memang betul"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«ぁ» får sjelden være med. Jeg blir bare kalt frem i ord som «fa-ito!» (kjemp!), men kreftene mine er ekte"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik, “ぁ”, kom bijna nooit aan de beurt. Alleen bij “faito!” (zet ’m op!) roepen ze me, maar ik ben echt sterk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„ぁ” rzadko ma okazję się pokazać. Wołają mnie prawie tylko w „faito!” (czyli „fight!”), ale siłę mam prawdziwą"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase nunca apareço, eu, o “ぁ”. Só me chamam para escrever coisas como “fight” em japonês, mas minha força é de verdade!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase nunca apareço, eu, o «ぁ». Só me chamam para escrever coisas como «fight» em japonês, mas a minha força é a sério!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt „ぁ”, care apar rar. Mă cheamă doar când se strigă „fa-i-to!” (fight!), dar puterea mea e adevărată!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я «ぁ», мне редко выпадает выход. Зовут меня разве что в «фа-айто!» — «давай, держись!», но сила у меня настоящая"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„ぁ“ sa veľmi často neukáže. Volajú ma skoro len vo „faito!“ (to je „fight!“), ale sila je skutočná"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilla ”ぁ” får sällan vara med. Mest bara i ”fa-ito!” (fight!), men min styrka är äkta"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ぁ” ที่แทบไม่ได้ออกโรง ถูกเรียกแค่ตอนตะโกน “fa-ito!” (สู้ๆ!) แต่ฝีมือของจริงนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pek sırası gelmeyen “ぁ”. Sadece “fight!” gibi seslerde çağrılırım ama gücüm gerçek"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я «ぁ», мене рідко кличуть — хіба що у вигуку «фа-а-айт!». Але сила в мене справжня"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ぁ” hiếm khi được ra sân. Chỉ được gọi khi hô “fa-ito!” (cố lên!) thôi, nhưng thực lực là thật đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很少有机会出场的“ぁ”。也就只有喊“fa-i-to！”（加油！）的时候才会被叫到，但实力可是货真价实的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很少有機會出場的「ぁ」。也就只有喊「fa-i-to！」（加油！）的時候才會被叫到，但實力可是貨真價實的"
          }
        }
      }
    },
