    "「ゅ」がつけば「しゅ」！　シュシュッと素早く回るよ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la «ゅ», «shi» es torna «shu»! Shu-shu, giro a tota velocitat!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S „ゅ“ se „ši“ změní na „šu“! Točím se šuply, bleskurychle!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ”ゅ” bliver ”し” til ”shu”! Jeg snurrer swish-swish lynhurtigt!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „ゅ“ wird aus „shi“ ein „shu“! Schu-schu – blitzschnell dreh ich mich!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ένα «ゅ», το «し» γίνεται «shu»! Σσσσιουπ, γυρίζω αστραπή!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add “ゅ” and \"shi\" turns into \"shu\"! Shoo-shoo, watch me zip around!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Con una “ゅ” la “shi” se vuelve “shu”! ¡Giro rapidísimo, shu-shu!"
