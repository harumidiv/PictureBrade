    "人は支え合って生きる……でも今日は、キミを倒すために回る！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les persones viuen ajudant-se… però avui giro per derrotar-te!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak „人“ jsou dvě čárky, které se podpírají, jako lidé… Ale dnes se točím, abych tě porazil!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennesker støtter hinanden… men i dag snurrer jeg for at slå dig!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menschen stützen einander … aber heute drehe ich mich, um dich zu besiegen!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι άνθρωποι στηρίζουν ο ένας τον άλλον… αλλά σήμερα γυρίζω για να σε νικήσω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People live by holding each other up... but today, I spin to take you down!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas viven apoyándose unas en otras… ¡pero hoy giro para derrotarte!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihmiset tukevat toisiaan… mutta tänään pyörin voittaakseni sinut!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
