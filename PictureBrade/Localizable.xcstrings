            "value" : "ประมาท……ไปหน่อย……"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz... gaflete düştüm..."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трохи… розслабився…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hơi……chủ quan rồi……"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍微……大意了……"
