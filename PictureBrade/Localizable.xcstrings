    "フッ……サングラスの奥の目は、キミの動きを全部見切っている" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmf… Darrere les ulleres de sol, endevino tots els teus moviments."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmpf… Za tmavými brýlemi vidím každý tvůj pohyb"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmf… Bag solbrillerne ser mine øjne hver eneste bevægelse, du laver"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pff … Hinter der Sonnenbrille sehe ich jede deiner Bewegungen voraus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χμφ… Τα μάτια πίσω από τα γυαλιά έχουν ήδη διαβάσει κάθε σου κίνηση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heh... behind these shades, my eyes see through every move you make."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je… Tras mis gafas de sol, mis ojos ya han leído todos tus movimientos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph… Aurinkolasien takana silmäni näkevät jokaisen liikkeesi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph… Derrière mes lunettes noires, je vois venir tous tes mouvements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हुँह... काले चश्मे के पीछे से मेरी आँखें तुम्हारी हर चाल पढ़ चुकी हैं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm… iza naočala moje oči već vide svaki tvoj potez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm……a napszemüvegem mögül minden mozdulatodat kiszúrom"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph…… mata di balik kacamata hitam ini membaca semua gerakanmu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmpf… Dietro gli occhiali da sole, prevedo ogni tua mossa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훗……선글라스 너머의 눈은 네 움직임을 전부 꿰뚫어 보고 있다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph... Di sebalik cermin mata hitam, mata aku dah baca semua gerak kamu"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmf … Bak solbrillene ser øynene mine hver eneste bevegelse du gjør"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmf… Achter deze zonnebril zien mijn ogen al jouw bewegingen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph… Zza ciemnych okularów widzę każdy twój ruch"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hehe… Atrás dos óculos escuros, meus olhos já leram todos os seus movimentos"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hehe… Atrás dos óculos de sol, os meus olhos já leram todos os teus movimentos"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm……Ochii din spatele ochelarilor îți citesc fiecare mișcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хм……глаза за тёмными очками видят все твои движения насквозь"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmpf… Za tmavými okuliarmi vidím každý tvoj pohyb"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmf… Bakom solglasögonen ser jag igenom alla dina rörelser"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฮึ……ดวงตาหลังแว่นดำ อ่านทุกการเคลื่อนไหวของเจ้าออกหมดแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hıh... Gözlüğün ardındaki gözlerim her hareketini çözdü"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хм… Очі за темними окулярами бачать кожен твій рух наскрізь"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hừ……đôi mắt sau cặp kính râm đã nhìn thấu mọi đường đi của ngươi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哼……墨镜后面的这双眼睛，早就看穿了你的一举一动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哼……墨鏡後面的這雙眼睛，早就看穿了你的一舉一動"
          }
        }
      }
    },
