        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Freistellen wird’s ein Kreis – schwächere Werte!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς αποκοπή γίνεται κύκλος και πέφτει η δύναμη!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it can't be cut out, it becomes a circle with lower stats!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Si no se puede recortar, queda redondo y pierde potencia!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos kuvaa ei voi rajata, siitä tulee pyöreä kiekko heikommilla ominaisuuksilla!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal détourée, elle devient ronde et perd en puissance !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कटआउट न बने तो गोला बन जाता है और परफ़ॉर्मेंस घटती है!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako izrezivanje ne uspije, čigra je okrugla i slabija!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nem sikerül kivágni, kör lesz belőle, és gyengébb!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau gagal dipotong, jadi bulat dan performanya turun!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non si ritaglia bene, diventa tonda e perde potenza!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오려 내지 못하면 동그라미가 되어 성능 다운!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau tak dapat dipotong, ia jadi bulat dan prestasi menurun!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke bildet klippes ut, blir det en rund skive med svakere egenskaper!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukt uitknippen niet, dan word je een rondje en minder sterk!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez wycięcia bączek będzie okrągły i słabszy!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não der para recortar, vira uma bola e perde desempenho!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não der para recortar, fica redondo e perde desempenho!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă nu se poate decupa, devine cerc și pierde din putere!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вырезать — волчок станет кругом, и характеристики снизятся!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez výrezu bude vĺčik okrúhly a slabší!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misslyckas utskärningen blir den rund och svagare!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าตัดภาพไม่ได้จะกลายเป็นวงกลม ค่าพลังลดลง!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesilemezse daire olur ve güç düşer!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо не вирізати — буде коло й сила знизиться!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tách được hình sẽ thành hình tròn và giảm chỉ số!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
