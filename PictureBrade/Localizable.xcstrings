    "口ほどにもないって？　言わせないよ！　四角い体はぶつかると痛いぞ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que soc tot xerrameca? Ni parlar-ne! El meu cos quadrat fa mal quan xoca!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myslíš, že jen mluvím? Kdepak! Moje hranaté tělo při nárazu bolí!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare snak og ingen snurren? Det skal du ikke sige! Min firkantede krop gør ondt at støde ind i!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Klappe, nichts dahinter? Das sagt mir keiner! Mein eckiger Körper tut weh, wenn er trifft!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ότι είμαι όλο λόγια; Ούτε να το σκεφτείς! Το τετράγωνο σώμα μου πονάει όταν σε χτυπάει!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All mouth and no spin? Don't you dare say that! My square body hurts when it hits!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Que soy pura boca? ¡Ni se te ocurra decirlo! ¡Mi cuerpo cuadrado duele cuando choca!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelkkää suunsoittoa? Sitä et sano! Neliskulmaiseen kehooni törmääminen sattuu!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute en paroles, moi ? Pas question ! Mon corps carré fait mal quand il cogne !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहते हो मैं सिर्फ़ मुँह चलाता हूँ? ऐसा मत कहना! चौकोर शरीर से टकराओगे तो दर्द होगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velika usta, mala snaga? Ne dam da to kažeš! Moje četvrtasto tijelo boli kad udari!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a szád jár? Na, azt ne mondd! A szögletes testem fáj, ha nekiütközöl!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuma omong besar? Nggak akan kubiarkan kamu bilang begitu! Badan kotakku sakit kalau ditabrak!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto chiacchiere, io? Neanche per sogno! Il mio corpo quadrato fa male quando colpisce!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입만 살았다고? 그런 말 못 하게 해 주지! 네모난 몸은 부딪치면 아프다고!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata aku cakap besar saja? Jangan cakap begitu! Badan segi empat aku ni sakit kalau terlanggar!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare prat og ingen snurring? Det skal du ikke si! Den firkantede kroppen min gjør vondt å dunke borti!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote mond en niks erachter? Dat zeg je niet tegen mij! Mijn vierkante lijf doet pijn als je ertegenaan botst!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myślisz, że tylko gadam? Nie ma mowy! Moje kwadratowe ciało boli przy zderzeniu!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só da boca pra fora? Nem pense em dizer isso! Meu corpo quadrado dói quando bate!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que sou só garganta? Nem penses em dizê-lo! O meu corpo quadrado magoa quando choca!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zici că am doar gură și nimic altceva? Nu te las! Corpul meu pătrat doare la lovitură!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Думаешь, я только болтать горазд? Не дождёшься! Квадратное тело бьёт больно!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myslíš, že len rečním? Kdeže! Moje hranaté telo pri náraze bolí!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara stora ord, säger du? Aldrig! Min fyrkantiga kropp gör ont att krocka med!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดีแต่ปากงั้นเหรอ? ไม่ยอมให้พูดหรอก! ร่างสี่เหลี่ยมนี้ชนแล้วเจ็บนะ!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laf ola beri gele mi? Söyletmem! Dört köşe gövdem çarpınca çok acıtır!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кажеш, я лише ротом мелю? Не дозволю! Квадратне тіло боляче б'ється!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ giỏi nói mồm á? Đừng hòng nói thế! Thân hình vuông vức va vào là đau đấy!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说我光会耍嘴皮子？才不准你这么说！方方正正的身体撞起来可是很痛的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你說我只會耍嘴皮子？才不准你這麼說！方方正正的身體撞起來可是很痛的！"
          }
        }
      }
    },
    "口ほどにもなかったのはボクのほうか……" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al final, el xerraire era jo…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takže jsem to já, kdo jen planě mluvil…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så var det mig, der bare var stor i munden…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Klappe, nichts dahinter … das war wohl ich …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τελικά εγώ ήμουν όλο λόγια…"
          }
        },
        "en" : {
          "stringUnit" : {
