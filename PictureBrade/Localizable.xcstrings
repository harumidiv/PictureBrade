        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volevo qualcuno su cui contare… Il prossimo, «口», è un gran chiacchierone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서로 기댈 상대가 필요했어……. 다음 “口”는 수다쟁이야"
