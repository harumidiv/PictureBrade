          "stringUnit" : {
            "state" : "translated",
            "value" : "“を”는 말과 말을 이어 주는 글자. 하지만 너랑 이어질 생각은 없어!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を” ialah huruf yang menyambung kata dengan kata. Tapi aku tak mahu bersambung dengan kamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«を» er bokstaven som binder ord sammen. Men med deg vil jeg ikke bindes!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を” is de letter die woorden aan elkaar verbindt. Maar met jóú wil ik niks te maken hebben!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„を” łączy słowa w zdaniu. Ale z tobą nie zamierzam się łączyć!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “を” é a letra que liga as palavras. Mas eu não quero ligação nenhuma com você!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O «を» é a letra que liga as palavras. Mas contigo não me quero ligar!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„を” e litera care leagă cuvintele între ele. Dar cu tine nu vreau nicio legătură!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«を» связывает слова между собой. Но с тобой я связываться не собираюсь!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„を“ spája slová vo vete. Ale s tebou sa spájať nemienim!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”を” är tecknet som binder ihop ord. Men ihop med dig vill jag inte bindas!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を” คือตัวอักษรที่เชื่อมคำกับคำ แต่ข้าไม่คิดจะเชื่อมกับเจ้าหรอก!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を” kelimeleri birbirine bağlayan harftir. Ama seninle bağ kurmaya hiç niyetim yok!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«を» з'єднує слова між собою. Але з тобою я з'єднуватися не збираюся!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を” là chữ nối từ với từ. Nhưng ta chẳng muốn nối gì với ngươi!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“を”是把词和词连起来的文字。不过，我才不跟你连在一起！"
          }
        },
