    "ワタシの輪っかは、回転のあかし。輪の中に閉じ込めてあげる" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El meu anell és la prova que sé girar. T'hi tancaré a dins!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můj prstenec je důkazem točení. Uzavřu tě do něj"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min ring er beviset på min snurren. Jeg spærrer dig inde i den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Ring ist der Beweis meiner Drehkraft. Ich sperre dich darin ein"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δαχτυλίδι μου είναι η απόδειξη του γυρίσματος. Θα σε κλειδώσω μέσα του"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My ring is the mark of my spin. I'll trap you inside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi anillo es la prueba de mi giro. Te encerraré dentro de él"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkaani on pyörimiseni todiste. Suljen sinut sen sisään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon anneau prouve que je sais tourner. Je vais t'enfermer dedans !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा छल्ला मेरे घूमने का सबूत है। तुम्हें इस छल्ले में क़ैद कर दूँगा"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moji prstenovi dokaz su vrtnje. Zarobit ću te u njima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyűrűm a pörgés bizonyítéka. Bezárlak a gyűrűmbe"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cincinku adalah bukti putaranku. Akan kukurung kamu di dalam cincin ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio anello è la prova che so girare. Ti ci chiuderò dentro!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 고리는 회전의 증표. 고리 안에 가둬 줄게"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelang aku bukti putaran aku. Aku kurung kamu dalam gelang ini"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringen min er beviset på snurringen min. Jeg stenger deg inne i den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
