    "ガハハ！　鬼の金棒ならぬ、鬼の回転を食らえ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha! No el garrot de l'ogre, sinó el gir de l'ogre: té!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chachacha! Démon s kyjem je silný, ale démon s otáčkami je ještě silnější!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Glem troldens jernkølle – smag på troldens snurren!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Keine Dämonenkeule – sondern die Dämonendrehung! Nimm das!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γκουαχαχα! Ξέχνα το ρόπαλο του δαίμονα — φάε το γύρισμα του δαίμονα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha! Forget the ogre's iron club — taste the ogre's spin!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ja, ja, ja! ¡Olvida el garrote del ogro y prueba el giro del ogro!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Unohda peikon rautanuija – maista peikon pyörimistä!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha ! Pas la massue de l'ogre, mais la rotation de l'ogre : prends ça !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाहाहा! दानव के हाथ में गदा ही काफ़ी डरावनी है, अब दानव का घूमना झेलो!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaha! Demon s batinom je jak, a demon s vrtnjom još jači — primi!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hahaha! Démon buzogánya helyett most a démon pörgését kapod!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Bukan gada iblis, tapi putaran iblis! Rasakan ini!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha! Non la mazza dell'orco, ma la rotazione dell'orco: beccati questa!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가하하! 도깨비 방망이 대신 도깨비 회전을 먹어라!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Raksasa dengan belantan memang hebat, tapi rasakan putaran raksasa ini!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Glem trollets jernklubbe – smak på trollets snurring!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha! Een oni met een knots is al eng, maar wacht maar tot je de draai van deze oni voelt!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwahaha! Demon z maczugą jest groźny, ale demon z obrotem — jeszcze groźniejszy!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha! Esqueça o porrete do ogro, prove o giro do ogro!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah ah ah! Esquece a moca do ogre e prova o giro do ogre!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha-ha! Nu bâta căpcăunului, ci rotirea căpcăunului — ia de-aici!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гха-ха! Это тебе не дубина демона, а вращение демона — получай!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chachacha! Démon s kyjakom je silný, ale démon s otáčkami je ešte silnejší!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! Glöm demonens järnklubba – känn på demonens snurr!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กะฮ่าฮ่า! ไม่ใช่กระบองยักษ์ แต่เป็นการหมุนของยักษ์ต่างหาก รับไป!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gahaha! İblisin topuzu değil, iblisin dönüşünü ye!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Га-га! Ось тобі не демонська палиця, а демонське обертання!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ha ha! Không phải gậy sắt của quỷ, mà là vòng quay của quỷ đây, nhận lấy!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘎哈哈！不是鬼的狼牙棒，是鬼的旋转！吃我一招！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘎哈哈！不是鬼的狼牙棒，是鬼的旋轉！吃我一招！"
          }
        }
      }
    },
    "ガラスのように透き通る" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
