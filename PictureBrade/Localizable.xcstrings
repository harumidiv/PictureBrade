    "パン、肉、チーズ、レタス！　重ねた具材のぶん、重くて強いぞ！　キミに勝ったら、絵文字パーティーのはじまりだ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa, carn, formatge, enciam! Com més pisos tinc, més pesant i fort soc! Si et guanyo, que comenci la festa dels emojis!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulka, maso, sýr, salát! Čím víc vrstev, tím jsem těžší a silnější! Až tě porazím, začne emoji-večírek!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bolle, bøf, ost og salat! Jo flere lag, jo tungere og stærkere! Når jeg har slået dig, starter emoji-festen!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brötchen, Fleisch, Käse, Salat! Je mehr Schichten, desto schwerer und stärker! Wenn ich dich besiege, steigt die Emoji-Party!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ψωμί, μπιφτέκι, τυρί, μαρούλι! Όσα περισσότερα υλικά, τόσο πιο βαρύ και δυνατό! Αν σε νικήσω, αρχίζει το πάρτι των emoji!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bun, patty, cheese, lettuce! The more I stack, the heavier and stronger I get! Once I beat you, the emoji party begins!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Pan, carne, queso, lechuga! ¡Cuantas más capas, más pesado y más fuerte! ¡Si te gano, empieza la fiesta de emojis!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sämpylä, pihvi, juusto ja salaatti! Mitä enemmän kerroksia, sitä painavampi ja vahvempi! Kun voitan sinut, emojibileet alkavat!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pain, steak, fromage, salade ! Plus j'ai d'étages, plus je suis lourd et fort ! Si je te bats, que la fête des emojis commence !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रेड, मीट, चीज़, सलाद! जितनी परतें, उतना भारी और ताक़तवर! तुम्हें हरा दिया, तो इमोजी पार्टी शुरू!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kruh, meso, sir, salata! Što više slojeva, to sam teži i jači! Kad te pobijedim, počinje emotikon-tulum!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsemle, hús, sajt, saláta! Minél több a réteg, annál nehezebb és erősebb vagyok! Ha legyőzlek, kezdődik az emoji-buli!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roti, daging, keju, selada! Makin banyak lapisan, makin berat dan kuat! Kalau aku menang, pesta emoji dimulai!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane, carne, formaggio, insalata! Più strati ho, più sono pesante e forte! Se ti batto, che la festa delle emoji abbia inizio!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빵, 고기, 치즈, 양상추! 쌓은 재료만큼 무겁고 강하다! 너를 이기면 이모지 파티의 시작이다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roti, daging, keju, salad! Makin banyak lapisan, makin berat dan kuat! Kalau aku menang, parti emoji bermula!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brød, kjøtt, ost og salat! Jo flere lag, jo tyngre og sterkere! Når jeg har slått deg, starter emoji-festen!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broodje, vlees, kaas, sla! Hoe meer lagen, hoe zwaarder en sterker! Als ik van je win, begint het emojifeest!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bułka, mięso, ser, sałata! Im więcej warstw, tym ciężej i mocniej! Jak cię pokonam, zaczyna się emoji-impreza!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão, carne, queijo, alface! Quanto mais camadas, mais pesado e mais forte! Se eu ganhar, começa a festa dos emojis!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão, carne, queijo, alface! Quanto mais camadas, mais pesado e mais forte! Se te ganhar, começa a festa dos emojis!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiflă, carne, brânză, salată! Cu atâtea straturi, sunt greu și puternic! Dacă te bat, începe petrecerea emoji!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Булка, котлета, сыр, салат! Сколько слоёв — столько веса и силы! Как только я тебя одолею, начнётся эмодзи-вечеринка!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žemľa, mäso, syr, šalát! Čím viac vrstiev, tým som ťažší a silnejší! Keď ťa porazím, začne sa emoji-párty!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bröd, kött, ost, sallad! Ju fler lager, desto tyngre och starkare! Vinner jag över dig börjar emojifesten!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขนมปัง เนื้อ ชีส ผักกาด! ยิ่งซ้อนเยอะยิ่งหนักยิ่งแกร่ง! ชนะเธอเมื่อไหร่ ปาร์ตี้อีโมจิเริ่มเลย!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekmek, köfte, peynir, marul! Kat kat malzemem kadar ağır ve güçlüyüm! Seni yenersem emoji partisi başlıyor!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Булка, м'ясо, сир, салат! Скільки начинки — стільки ваги й сили! Як переможу тебе — почнеться вечірка емодзі!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bánh mì, thịt, phô mai, xà lách! Càng nhiều tầng càng nặng càng mạnh! Thắng cậu xong là bữa tiệc emoji bắt đầu!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面包、肉饼、芝士、生菜！叠得越多，就越重越强！等我打赢你，表情符号派对就开始啦！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麵包、肉排、起司、生菜！疊得越多，就越重越強！等我打贏你，表情符號派對就開始啦！"
          }
        }
      }
    },
