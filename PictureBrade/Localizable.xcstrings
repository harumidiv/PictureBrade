          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mysterious gadgets left behind by the emoji became treasures for your Photo Blade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artefactos misteriosos que dejaron los emojis se convirtieron en tesoros de tu Photo Blade."
