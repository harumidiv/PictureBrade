          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa-pa-pa-PAAAN! Not dots but a little circle — here comes the special “ぱ”! That popping POP sound is my treasure!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tarará-chan! ¡Llega la “ぱ”, especial con circulito en vez de puntitos! ¡El sonido de estallido es mi tesoro!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadadaaa! Tässä tulee erityinen ”ぱ” – pisteiden sijaan rengas! Poksahtava ääni on suurin aarteeni!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa-pa-ra-paaam ! Pas de petits points pour moi, mais un petit rond : voici le « ぱ » spécial ! Le bruit « pop ! » qui éclate, c'est mon trésor !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पप्पारा-पाँ! बिंदु नहीं, गोला लगाए ख़ास “ぱ” आ गया! ये पॉप की आवाज़ मेरा ख़ज़ाना है!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarara-pam! Nisam s točkicama nego s kružićem — posebni „ぱ“ stiže! Zvuk pucanja „pop!“ moje je blago!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taratatam! Itt van a különleges „ぱ”, akin pöttyök helyett karika van! A pukkanó hang az én kincsem!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa-pa-ra-paaam! Bukan dua titik, tapi bulatan! Inilah “ぱ” yang istimewa! Bunyi letupan pop itu harta karunku!"
