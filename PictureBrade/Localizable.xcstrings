    "覇王様の前に、ドカンと一発！　爆発的な回転を見せてやる！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davant del Senyor Suprem, un bon BUM! Admira el meu gir explosiu!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než předstoupíš před Vládce — BUM! Ukážu ti výbušné točení!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før Overherren – ét stort BRAG! Se min eksplosive snurren!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du zum Herrscher kommst – ein großer Knall! Sieh meine explosive Drehung!"
