    "受け流しきれなかった……。木はしぶといわよ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No he pogut esquivar-ho tot… Compte, el «木» és tossut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedokázala jsem všechno odrazit… Strom je houževnatý, pozor"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kunne ikke lede det hele væk… Træ er sejt, skal du vide"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich konnte nicht alles abwehren … Das Holz ist zäh, pass auf"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπόρεσα να το αποκρούσω… Το Ξύλο είναι πεισματάρικο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I couldn't deflect it all... “木” is a stubborn one, you know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pude esquivarlo del todo… Cuidado, el árbol es muy tenaz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pystynyt ohjaamaan kaikkea ohi… Puu on sitkeä, tiedoksi vain"
