    "根を張った木は倒れない。長期戦なら負けないぞ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arbre ben arrelat no cau. En un combat llarg, no perdré!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strom s kořeny nepadne. V dlouhém boji neprohraju"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et træ med dybe rødder vælter ikke. I en lang kamp taber jeg ikke!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Baum mit tiefen Wurzeln fällt nicht. Im Dauerkampf verliere ich nicht"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δέντρο με βαθιές ρίζες δεν πέφτει. Σε μακρά μάχη δεν χάνω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tree with deep roots never falls. I won't lose a long battle!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un árbol bien enraizado no cae. ¡En una batalla larga no pierdo!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juurtunut puu ei kaadu. Pitkässä ottelussa en häviä!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arbre bien enraciné ne tombe pas. Dans un long combat, je ne perdrai pas !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जड़ जमाया पेड़ नहीं गिरता। लंबा मुक़ाबला हो तो मैं नहीं हारूँगी"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drvo s dubokim korijenjem ne pada. U dugoj borbi ne gubim!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyökeret eresztett fa nem dől ki. Hosszú csatában nem veszíthetek"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohon yang berakar tak akan tumbang. Kalau pertarungan panjang, aku nggak bakal kalah"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un albero con radici profonde non cade. Nelle sfide lunghe non perdo!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뿌리내린 나무는 쓰러지지 않는다. 장기전이라면 지지 않아"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokok yang berakar takkan tumbang. Kalau pertarungan panjang, aku takkan kalah"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tre med dype røtter faller ikke. I en lang kamp taper jeg ikke!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een boom met diepe wortels valt niet om. In een lang gevecht verlies ik niet"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drzewo z korzeniami się nie przewróci. W długiej walce nie przegram"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árvore bem enraizada não cai. Em batalha longa eu não perco!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árvore bem enraizada não cai. Num combate longo não perco!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copacul cu rădăcini adânci nu cade. La o luptă lungă nu pierd!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дерево с корнями не упадёт. В долгом бою мне нет равных"
          }
        },
