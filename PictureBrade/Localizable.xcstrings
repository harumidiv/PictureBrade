    "とがった先端で長く回る" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una punta fina que gira molta estona"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrá špička se točí dlouho"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spids spids, der snurrer længe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreht lange auf spitzer Spitze"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μυτερή άκρη για μακρύ γύρισμα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointed tip for long spins"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta afilada para girar mucho tiempo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terävä kärki pyörii pitkään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pointe fine qui tourne longtemps"
          }
        },
        "hi" : {
