    "ぷんぷん！　なんでジャマするの！　怒りの回転を受けてみろ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Per què ens molestes?! Tasta el meu gir de ràbia!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Proč nás rušíš?! Ochutnej vzteklé otáčky!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Hvorfor blander du dig?! Smag på min vrede snurren!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Warum störst du mich?! Spür meine Wut-Drehung!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γρρρ! Γιατί μου χαλάς τα σχέδια; Φάε το θυμωμένο μου γύρισμα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph! Why are you getting in my way?! Take my spin of fury!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Grrr! ¿¡Por qué me molestas!? ¡Prueba mi giro furioso!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Miksi sotkeudut asioihini?! Maista vihaista pyörimistäni!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr ! Pourquoi tu nous embêtes ?! Goûte à ma rotation de colère !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हुँह! मुझे क्यों रोक रहे हो! ग़ुस्से का घुमाव झेलो!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Zašto mi smetaš?! Primi ljutu vrtnju!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Miért akadékoskodsz? Kóstold meg a dühös pörgést!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huh! Kenapa kamu ganggu?! Rasakan putaran amarahku!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Perché ci disturbi?! Assaggia la mia rotazione furiosa!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "씩씩! 왜 방해하는 거야! 분노의 회전을 받아라!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmph! Kenapa kacau aku? Rasakan putaran kemarahan ini!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Hvorfor blander du deg inn?! Smak på min sinte snurring!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Waarom zit je me dwars?! Proef mijn woedende draai!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Czemu nam przeszkadzasz?! Poczuj obrót gniewu!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grrr! Por que você está atrapalhando?! Prove meu giro furioso!"
          }
