    "夜空に浮かぶ三日月。ほそい体で、するどく切り裂く！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lluna creixent que sura al cel. Amb el meu cos prim, tallo en sec!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srpek měsíce na noční obloze. Mým tenkým tělem ostře řežu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En halvmåne på nattehimlen. Med min tynde krop skærer jeg skarpt igennem!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mondsichel am Nachthimmel. Mit meinem schmalen Körper schneide ich scharf zu!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μισοφέγγαρο στον νυχτερινό ουρανό. Με το λεπτό μου σώμα κόβω σαν ξυράφι!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A crescent moon floating in the night sky. With my slender body, I'll slice right through you!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luna creciente flota en el cielo nocturno. ¡Con mi cuerpo fino te corto en un zas!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuunsirppi yötaivaalla. Ohuella kehollani viillän terävästi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le croissant de lune qui flotte dans le ciel. Mon corps fin tranche net !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रात के आसमान में अर्धचंद्र। पतले शरीर से तेज़ी से चीर दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjesečev srp na noćnom nebu. Tankim tijelom režem oštro!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holdsarló az éjszakai égen. Vékony testemmel élesen hasítok!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan sabit di langit malam. Dengan tubuh ramping, aku menyayat tajam!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La falce di luna che fluttua nel cielo notturno. Con il mio corpo sottile, taglio di netto!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤하늘에 뜬 초승달. 가느다란 몸으로 날카롭게 베어 낸다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan sabit di langit malam. Dengan badan nipis, aku belah dengan tajam!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En månesigd på nattehimmelen. Med den tynne kroppen min skjærer jeg skarpt!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een maansikkel aan de nachthemel. Met mijn dunne lijf snij ik messcherp!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Półksiężyc na nocnym niebie. Moje cienkie ciało tnie ostro!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lua crescente flutua no céu da noite. Com meu corpo fino, corto você num instante!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lua em quarto crescente flutua no céu noturno. Com o meu corpo fino, corto-te num instante!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semiluna plutește pe cerul nopții. Cu trupul meu subțire, tai ca o lamă!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месяц в ночном небе. Тонким телом режу остро!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosáčik mesiaca na nočnej oblohe. Mojím tenkým telom ostro režem!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En månskära på natthimlen. Med min smala kropp skär jag skarpt!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จันทร์เสี้ยวลอยบนฟ้ายามค่ำ ด้วยร่างผอมบาง จะเฉือนให้คมกริบ!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece göğünde süzülen hilal. İnce gövdemle keskin keskin keserim!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Півмісяць у нічному небі. Тонким тілом розітну гостро!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vầng trăng khuyết trên trời đêm. Với thân hình mảnh mai, tớ sẽ chém thật sắc!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮在夜空中的弯月。用纤细的身体，锐利地切开一切！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮在夜空中的彎月。用纖細的身體，銳利地切開一切！"
          }
        }
      }
    },
