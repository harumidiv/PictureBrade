    "水に点を1つ足せば氷。冷たく、鋭く、回り続ける" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix un punt a l'aigua «水» i tens el gel «氷». Fred i esmolat, giro sense parar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej k vodě jednu tečku a vznikne led. Studený, ostrý, točící se bez konce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt en prik på ”水”, og du får ”氷”. Kold og skarp snurrer jeg videre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Punkt mehr auf „水“ – schon wird es „氷“, Eis. Kalt, scharf und unaufhörlich drehend"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε μια τελεία στο νερό «水» και γίνεται πάγος «氷». Κρύο, κοφτερό, γυρίζει ασταμάτητα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a single dot to 水 and you get 氷 — ice. Cold, sharp, and always spinning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un punto a “水” (agua) y obtienes “氷”, el hielo. Frío, afilado y sin dejar de girar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää yksi piste ”水”-merkkiin, niin saat ”氷”. Kylmänä ja terävänä pyörin yhä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un point à l'eau « 水 » et tu obtiens la glace « 氷 ». Froide et tranchante, je tourne sans fin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पानी “水” में एक बिंदु जोड़ो, बन जाती है बर्फ़ “氷”। ठंडी, तेज़, घूमती रहती हूँ"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodi dodaj jednu točku i dobiješ led. Hladno, oštro, i vrti se bez kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj egy pöttyöt a „水”-hez (víz), és „氷” (jég) lesz belőle. Hidegen, élesen, megállás nélkül pörgök"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah satu titik ke air, jadilah es. Dingin, tajam, terus berputar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un punto all'acqua «水» e ottieni il ghiaccio «氷». Freddo e tagliente, giro senza sosta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“水”에 점 하나를 더하면 “氷”(얼음). 차갑게, 날카롭게, 계속 돈다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah satu titik pada air “水”, jadilah ais “氷”. Sejuk, tajam, terus berputar"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett en prikk på «水», og du får «氷». Kald og skarp snurrer jeg videre"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet één stip bij water en je krijgt ijs. Koud, scherp en altijd draaiend"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj do wody jedną kreskę, a powstanie lód. Zimny, ostry, wirujący bez końca"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um ponto em “水” (água) e vira “氷”, o gelo. Frio, afiado e sempre girando"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta um ponto a «水» (água) e passa a «氷», o gelo. Frio, afiado e sempre a girar"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune un punct la „水” (apă) și obții „氷”, gheața. Rece, tăios, mă rotesc întruna!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь к «水» одну точку — получится лёд «氷». Холодный, острый, крутится без конца"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridaj k vode jednu bodku a vznikne ľad. Studený, ostrý, točiaci sa bez konca"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg en prick på ”水” så blir det ”氷” – is. Kall, vass och evigt snurrande"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เติมจุดหนึ่งจุดให้ “水” (น้ำ) กลายเป็น “氷” (น้ำแข็ง) เย็นเยียบ คมกริบ หมุนไม่หยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“水”ya bir nokta ekle, “氷” olur. Soğuk, keskin ve durmadan dönerim"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай до «水» одну крапку — і вийде «氷», лід. Холодний, гострий і невпинний"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một chấm vào “水” (nước) là thành “氷” (băng). Lạnh lẽo, sắc bén, quay mãi không ngừng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“水”上加一点，就成了“氷”。冰冷、锐利，旋转不停"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「水」上加一點，就成了「氷」。冰冷、銳利，旋轉不停"
          }
        }
      }
    },
