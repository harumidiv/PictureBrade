    "十六画の体に宿るは龍の魂。天を舞う回転、見せてやろう" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dins dels meus setze traços hi viu l'ànima d'un drac. Admira el meu gir que dansa pel cel!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V těle ze šestnácti tahů dlí duše draka. Pohleď na točení, které se vznáší k nebesům"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en krop med 16 streger bor dragens sjæl. Se min snurren, der danser på himlen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In meinem Körper aus sechzehn Strichen wohnt die Seele eines Drachen. Sieh meine himmelstürmende Drehung!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο σώμα των δεκαέξι πινελιών κατοικεί η ψυχή του δράκου. Δες ένα γύρισμα που χορεύει στους ουρανούς"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Within my sixteen strokes dwells the soul of a dragon. Behold my spin that soars through the heavens!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mi cuerpo de dieciséis trazos habita el alma de un dragón. ¡Mira mi giro que surca los cielos!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16 vedon kehossani asuu lohikäärmeen sielu. Katso, miten pyörimiseni tanssii taivaalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans mes seize traits loge l'âme d'un dragon. Admire ma rotation qui danse dans le ciel !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोलह लकीरों के शरीर में बसी है ड्रैगन की आत्मा। आसमान में उड़ता घुमाव देखो"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U tijelu od šesnaest poteza živi zmajeva duša. Pogledaj vrtnju koja leti nebom!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tizenhat vonásos testemben a sárkány lelke lakozik. Megmutatom az égben szálló pörgést"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tubuh enam belas goresan bersemayam jiwa naga. Kutunjukkan putaran yang menari di langit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei miei sedici tratti vive l'anima di un drago. Ammira la mia rotazione che danza nel cielo!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열여섯 획의 몸에 깃든 것은 용의 혼. 하늘을 춤추는 회전, 보여 주마"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam badan enam belas garis ini bersemayam jiwa naga. Saksikan putaran yang terbang ke langit"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en kropp med 16 streker bor dragens sjel. Se snurringen min som danser på himmelen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In mijn lijf van zestien streepjes woont de ziel van een draak. Aanschouw mijn draai die door de hemel danst"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ciele z szesnastu kresek mieszka dusza smoka. Zobacz obrót, który szybuje w niebiosach"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No meu corpo de dezesseis traços vive a alma de um dragão. Veja meu giro que voa pelos céus!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No meu corpo de dezasseis traços vive a alma de um dragão. Vê o meu giro que voa pelos céus!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În corpul meu de șaisprezece trăsături sălășluiește sufletul dragonului. Îți arăt o rotire ce zboară spre cer!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В теле из шестнадцати черт живёт душа дракона. Узри вращение, парящее в небесах!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tele zo šestnástich ťahov prebýva duša draka. Pozri sa na točenie, ktoré sa vznáša k nebesiam"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sexton streck bor drakens själ. Se min snurrande himladans!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในร่างสิบหกขีดคือวิญญาณมังกร จะแสดงการหมุนที่ร่ายรำบนฟ้าให้ดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On altı çizgili gövdemde ejderha ruhu yaşar. Göklerde süzülen dönüşümü göstereyim"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тілі з шістнадцяти рисок живе душа дракона. Зараз покажу обертання, що злітає до небес"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong thân mười sáu nét là linh hồn rồng. Để ta cho ngươi thấy vòng quay bay lượn trên trời"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十六画的身躯中，寄宿着龙之魂。让你见识翱翔天际的旋转吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十六畫的身軀中，寄宿著龍之魂。讓你見識翱翔天際的旋轉吧"
          }
        }
      }
    },
    "取り戻した5つのお宝は、キミのフォトブレードを飾る力になった。" : {
      "localizations" : {
        "ca" : {
