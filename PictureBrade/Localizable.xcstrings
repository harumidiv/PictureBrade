    "ちっ、水があれば消えるとは思っていたが……写真に消されるとはな" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk… Ja sabia que l'aigua em podia apagar… però que m'apagués una foto…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pch, myslel jsem, že mě uhasí jen voda… a zhasla mě fotka"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk. Jeg vidste, at vand kunne slukke mig… men at blive slukket af et foto…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tss, dass Wasser mich löschen könnte, dachte ich mir … aber von einem Foto gelöscht zu werden …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τσκ, ήξερα ότι το νερό με σβήνει… αλλά να με σβήσει μια φωτογραφία;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tch. I always figured water would put me out... but a photo?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bah, sabía que el agua podía apagarme… pero ¿una foto?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pöh. Tiesin, että vesi voi sammuttaa minut… mutta että valokuva…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tss… Je me doutais que l'eau pouvait m'éteindre… mais me faire éteindre par une photo…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हुँह, सोचा था पानी ही मुझे बुझा सकता है... पर एक फ़ोटो ने बुझा दिया"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tch, znao sam da me voda može ugasiti… ali da me ugasi fotografija…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tch, tudtam, hogy a víz eloltana……de hogy egy fénykép oltson ki……"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cih, aku tahu air bisa memadamkanku…… tapi dipadamkan oleh foto?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk… Sapevo che l'acqua poteva spegnermi… ma farmi spegnere da una foto…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칫, 물이 있으면 꺼질 줄은 알았지만……사진에 꺼질 줄이야"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cis, aku sangka cuma air yang boleh padamkan aku... rupa-rupanya foto pun boleh"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk. Jeg visste at vann kunne slukke meg … men å bli slukket av et foto …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk, ik wist dat water me kon doven… maar door een fóto?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsk, myślałem, że zgasi mnie tylko woda… a tu zgasiło mnie zdjęcie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunf, eu sabia que a água podia me apagar… mas uma foto?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunf, eu sabia que a água me podia apagar… mas uma fotografia?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfui, știam că apa mă poate stinge……dar să fiu stins de o poză……"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тьфу, я думал, меня погасит разве что вода……а погасила фотография"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pch, myslel som, že ma uhasí len voda… a zhasla ma fotka"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tss, jag visste att vatten kunde släcka mig… men att ett foto skulle göra det"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชิ รู้อยู่หรอกว่าเจอน้ำแล้วจะดับ……แต่ไม่คิดว่าจะโดนรูปถ่ายดับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüh, suyla söneceğimi biliyordum ama... bir fotoğrafla söneceğim aklıma gelmezdi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тьху, я думав, мене погасить хіба що вода… а погасило фото"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hừ, ta biết gặp nước thì sẽ tắt……nhưng không ngờ lại bị một bức ảnh dập tắt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啧，我早料到碰到水会熄灭……没想到竟被照片给灭了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘖，我早料到碰到水會熄滅……沒想到竟被照片給滅了"
          }
        }
      }
