        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga ga ga! Thêm hai dấu chấm, “か” biến thành “が”!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘎嘎嘎！加上两个点，“か”(ka) 就变身成“が”(ga) 啦！"
          }
