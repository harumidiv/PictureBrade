    "ケロケロ！　ぴょんと跳ねて、ケロっと勝っちゃうケロ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rac rac! Un saltiró i guanyo sense despentinar-me, rac!"
          }
        },
        "cs" : {
