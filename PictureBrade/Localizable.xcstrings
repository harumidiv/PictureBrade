          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다 흘려보내지 못했어……. “木”은 끈질기다고"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak dapat elak sepenuhnya... Si kayu tu memang liat, tau"
          }
        },
        "nb" : {
          "stringUnit" : {
