          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dòng chảy đã ngừng……. Chiếc trống này tặng ngươi, hãy đánh thật vang nhé. Cẩn thận, phía trước là các con chữ Ngũ Hành đang chờ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
