        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csilingeling! Tekerem a pedált, és körbe-körbe pörgök!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kring-kring! Kayuh pedalnya, berputar terus!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drin drin! Pedalo e giro in tondo!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따르릉따르릉! 페달을 밟아 빙글빙글 돈다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kring kring! Kayuh pedal, pusing-pusing!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kling-kling! Jeg tråkker på pedalene og suser rundt og rundt!"
          }
        },
        "nl" : {
          "stringUnit" : {
