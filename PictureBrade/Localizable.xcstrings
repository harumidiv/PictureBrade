        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho… mi sono distratta…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝……방심했어……"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku... leka sikit..."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg var litt … for uforsiktig …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik was… even niet opgelet…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochę… się zagapiłem…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu… me distraí um pouco…"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu… distraí-me um bocadinho…"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am fost……cam neatent……"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чуть-чуть……зазевалась……"
          }
        },
        "sk" : {
          "stringUnit" : {
