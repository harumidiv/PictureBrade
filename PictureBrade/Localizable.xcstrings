    "笹を食べて……出直す……。ジャングルの王様が怒ってるよ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaré bambú… i tornaré més fort… El rei de la jungla està enfadat, eh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Půjdu… se najíst bambusu a vrátím se… Král džungle zuří"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg spiser bambus… og prøver igen… Junglens konge er vred, skal jeg sige dig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich futtere Bambus … und komme wieder … Der König des Dschungels ist sauer"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
