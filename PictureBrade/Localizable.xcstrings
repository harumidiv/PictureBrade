    "燃え広がる前に……消された……" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'han apagat… abans d'escampar-me…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než jsem se rozhořel… uhasili mě…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slukket… før jeg nåede at brede mig…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ich mich ausbreiten konnte … gelöscht …"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν προλάβω να απλωθώ… με έσβησαν…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put out... before I could spread..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me apagaron… antes de propagarme…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammutettiin… ennen kuin ehdin levitä…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteint… avant même d'avoir pu me propager…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फैलने से पहले... बुझा दिया गया..."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugašen sam… prije nego što sam se raširio…"
