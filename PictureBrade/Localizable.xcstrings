    "ひらがなたちは、あいうえお順に並んで、こどもの国のおもちゃ箱へ帰っていく。" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els hiragana fan fila, en ordre A-I-U-E-O, i tornen al bagul de joguines del País dels Infants."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiragana se seřadí pěkně po pořádku a vrací se do krabice s hračkami v Dětské říši."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiraganaerne stiller sig op i alfabetisk rækkefølge og går hjem til legetøjskassen i Børnelandet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hiragana stellen sich schön der Reihe nach auf und kehren in die Spielzeugkiste im Kinderland zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα χιραγκάνα μπήκαν στη σειρά, με τη σειρά a-i-u-e-o, και γύρισαν στο κουτί με τα παιχνίδια της Χώρας των Παιδιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hiragana line up in A-I-U-E-O order and head home to the toy box in Kids' Land."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hiraganas se ponen en fila, en orden, y vuelven al baúl de juguetes del País de los Niños."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiraganat asettuvat aakkosjärjestykseen ja palaavat Lasten maan lelulaatikkoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hiragana se mettent en rang, dans l'ordre A-I-U-E-O, et rentrent dans le coffre à jouets du Pays des Enfants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिरागाना अ-इ-उ-ए-ओ के क्रम में कतार बनाकर बच्चों के देश के खिलौनों के डिब्बे में लौट गए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiragana slova poredala su se po redu i vratila u kutiju s igračkama u Dječjoj zemlji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hiraganák szép sorban, あ-い-う-え-お rendben visszatérnek Gyerekország játékosládájába."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hiragana berbaris urut A-I-U-E-O, lalu pulang ke kotak mainan di Negeri Anak-Anak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli hiragana si mettono in fila, in ordine A-I-U-E-O, e tornano nella cesta dei giocattoli del Paese dei Bambini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "히라가나들은 아이우에오 순서로 줄을 서서 어린이 나라의 장난감 상자로 돌아간다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiragana berbaris ikut urutan A-I-U-E-O dan pulang ke kotak mainan di Negeri Kanak-kanak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiraganaene stiller seg opp i alfabetisk rekkefølge og går hjem til lekekassa i Barnas land."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hiragana gaan netjes op a-i-u-e-o-volgorde in de rij staan en keren terug naar de speelgoedkist in het Kinderland."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiragany ustawiają się po kolei jak w alfabecie i wracają do pudła z zabawkami w Krainie Dzieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os hiraganas fazem fila, em ordem, e voltam para o baú de brinquedos da Terra das Crianças."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os hiraganas põem-se em fila, por ordem, e voltam para a caixa de brinquedos da Terra das Crianças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Literele hiragana s-au aliniat în ordinea A-I-U-E-O și s-au întors în cutia cu jucării din Țara Copiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буквы хираганы выстроились по порядку азбуки и отправились обратно в ящик с игрушками Детской страны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiragana sa zoradí pekne po poriadku a vracia sa do krabice s hračkami v Detskej ríši."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiraganatecknen ställer sig i A-I-U-E-O-ordning och går hem till leksakslådan i Barnens land."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหล่าฮิรางานะเข้าแถวตามลำดับตัวอักษร กลับเข้ากล่องของเล่นในดินแดนเด็ก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiraganalar alfabe sırasına dizilip Çocuk Ülkesi'ndeki oyuncak sandığına geri dönüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хіраґана вишикувалася за абеткою й повернулася до скрині з іграшками в Країні дітей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chữ hiragana xếp hàng theo thứ tự bảng chữ cái, trở về hộp đồ chơi ở Xứ Sở Trẻ Em."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平假名们按照a-i-u-e-o的顺序排好队，回到了儿童王国的玩具箱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平假名們按照a-i-u-e-o的順序排好隊，回到了兒童王國的玩具箱。"
          }
        }
      }
    },
