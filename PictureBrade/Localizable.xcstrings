    "手に入れたパーツは、ホームの「マイコマ」でコマをタップすると装備できる" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per equipar les peces aconseguides, toca una baldufa a «Les meves baldufes» de l'inici"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Získané díly vybavíš klepnutím na káču v „Moje káči“ na domovské obrazovce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dele, du får, kan udstyres ved at trykke på en top under ”Mine toppe” på startskærmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Teile rüstest du aus, indem du unter „Meine Kreisel“ auf dem Startbildschirm einen Kreisel antippst"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κομμάτια που κερδίζεις τα εξοπλίζεις πατώντας μια σβούρα στις «Σβούρες μου» στην Αρχική"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To equip parts you got, tap a top in \"My Tops\" on the Home screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para equipar las piezas conseguidas, toca un trompo en “Mis trompos” desde el inicio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saamasi osat voi varustaa napauttamalla hyrrää aloitusnäytön kohdassa ”Omat hyrrät”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour équiper les pièces obtenues, touche une toupie dans « Mes toupies » sur l'accueil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिले पार्ट्स होम के “मेरे लट्टू” में लट्टू पर टैप करके इक्विप कर सकते हो"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobivene dijelove opremi tako da na početnom zaslonu u „Mojim čigrama“ dodirneš čigru"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megszerzett alkatrészeket a főoldal „Pörgettyűim” részében, egy pörgettyűre koppintva szerelheted fel"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part yang didapat bisa dipasang dengan mengetuk gasing di “Gasingku” pada Beranda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per equipaggiare i pezzi ottenuti, tocca una trottola in «Le mie trottole» nella Home"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얻은 파츠는 홈의 “내 팽이”에서 팽이를 탭하면 장착할 수 있어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat ganti yang diperoleh boleh dipakai dengan mengetik gasing di “Gasing Saya” di Laman Utama"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler du får, kan utstyres ved å trykke på en snurrebass under «Mine snurrebasser» på startskjermen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdelen die je krijgt, rust je uit door in “Mijn tollen” op het beginscherm op een tol te tikken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdobyte części wyposażysz, stukając bączka w „Moje bączki” na ekranie głównym"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para equipar as peças conseguidas, toque em um pião em “Meus piões” na tela inicial"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
