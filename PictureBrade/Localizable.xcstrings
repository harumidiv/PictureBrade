        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ điển Quốc ngữ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国语辞典"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "國語辭典"
          }
        }
      }
    },
    "地球は情報が多すぎて、頭がドカーン！　飛び散るキラキラ星といっしょに、キミを吹き飛ばす！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la Terra hi ha massa informació, i el cap em fa BUM! T'enviaré volant amb les meves estrelles brillants!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Zemi je moc informací, hlava mi vybuchne! Odpálím tě i s třpytivými hvězdičkami!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jorden har alt for meget information – mit hoved går KABOOM! Sammen med glimtende stjerner blæser jeg dig væk!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erde hat zu viele Infos – mein Kopf macht KABUMM! Zusammen mit den Glitzersternen pust ich dich weg!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Γη έχει τόσες πληροφορίες που μου έσκασε το κεφάλι! Μαζί με λαμπερά αστεράκια, θα σε εκτοξεύσω!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earth has way too much information — my head's going KABOOM! I'll blast you away along with my flying sparkle stars!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡La Tierra tiene tanta información que me explota la cabeza! ¡Te mandaré a volar junto con las estrellas brillantes!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maassa on aivan liikaa tietoa – pääni sanoo KABUM! Kimaltavien tähtien kanssa puhallan sinut tiehesi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Terre, c'est trop d'infos d'un coup, ma tête fait BOUM ! Je vais t'envoyer valser avec mes étoiles scintillantes !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धरती पर इतनी जानकारी है कि सिर फट गया! बिखरते चमकीले तारों के साथ तुम्हें उड़ा दूँगा!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Zemlji je previše informacija — glava mi eksplodira! Odbacit ću te zajedno s raspršenim zvjezdicama!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Földön túl sok az információ, felrobban a fejem! A szétszóródó csillagokkal együtt elrepítelek!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumi punya terlalu banyak informasi, kepalaku meledak, DUAR! Bersama bintang-bintang berkilau, kuterbangkan kamu!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla Terra ci sono troppe informazioni, la testa mi fa BUM! Ti spazzo via insieme alle mie stelline scintillanti!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지구는 정보가 너무 많아서 머리가 펑! 흩날리는 반짝이 별과 함께 너를 날려 버릴 거야!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumi ada terlalu banyak maklumat, kepala aku meletup! Bersama bintang berkilauan yang bertaburan, aku hempas kamu jauh-jauh!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jorda har altfor mye informasjon – hodet mitt går KABOM! Sammen med glitrende stjerner blåser jeg deg vekk!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aarde heeft zoveel informatie dat mijn hoofd ontploft! KABOEM! Samen met de glinsterende sterren blaas ik je weg!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Ziemi jest za dużo informacji, głowa mi wybucha! Wystrzelę cię razem z brokatowymi gwiazdkami!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Terra tem informação demais e minha cabeça explodiu! Vou mandar você longe junto com as estrelas brilhantes!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Terra tem informação a mais e a minha cabeça explodiu! Vou mandar-te pelos ares com as estrelas brilhantes!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pământul are prea multe informații, mi-a explodat capul! Te arunc în aer odată cu stelele sclipitoare!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Земле столько информации, что у меня взорвался мозг! Вместе с разлетающимися звёздочками я снесу и тебя!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Zemi je priveľa informácií, hlava mi vybuchne! Odpálim ťa aj s trblietavými hviezdičkami!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jorden har så mycket information att mitt huvud går BOOM! Tillsammans med glitterstjärnorna blåser jag iväg dig!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกมีข้อมูลเยอะเกินไป หัวระเบิดตูม! จะส่งเธอปลิวไปพร้อมดาววิบวับที่กระจายทั่ว!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dünya'da bilgi o kadar çok ki kafam BUUM! Saçılan pırıl pırıl yıldızlarla birlikte seni uçuracağım!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Землі забагато інформації, аж голова — бабах! Здую тебе разом із блискучими зірочками!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trái Đất nhiều thông tin quá, đầu nổ bùm! Cùng với những ngôi sao lấp lánh bay tứ tung, tớ sẽ thổi bay cậu!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球的信息太多了，脑袋都要炸啦！我要连同四处飞散的闪亮星星，把你一起轰飞！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球的資訊太多了，腦袋都要炸啦！我要連同四處飛散的閃亮星星，把你一起轟飛！"
          }
        }
      }
    },
    "地響きとともに現れたのは、伝説に語られる獣の文字たち。吹き荒れる嵐の中で、チリーンと鈴の音が鳴り続けている。" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb un retruny de terra apareixen les lletres de les bèsties llegendàries. Enmig de la tempesta, un cascavell no para de dringar: ding…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dunění země se objevily šelmí znaky z legend. Uprostřed zuřící bouře stále zvoní zvoneček."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med et brag fra jorden dukkede sagnvæsnernes tegn op. I den rasende storm ringer en klokke kling-kling uden ophør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Erdbeben erscheinen die Zeichen der Bestien aus den Legenden. Mitten im tosenden Sturm klingelt unaufhörlich ein Glöckchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ένα βουητό της γης εμφανίστηκαν τα γράμματα-θηρία των θρύλων. Μέσα στη λυσσασμένη καταιγίδα, ένα καμπανάκι ηχεί ασταμάτητα, ντιν-ντιν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a rumble of the earth appear the letters of legendary beasts. Amid the raging storm, the ding-a-ling of a bell keeps ringing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre temblores aparecen las letras de bestias legendarias. En medio de la tormenta no deja de sonar una campanilla: ¡tilín!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maan jyristessä ilmestyivät tarujen petojen merkit. Raivoavassa myrskyssä kello kilisee lakkaamatta kilin-kilin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un grondement de tonnerre surgissent les lettres des bêtes légendaires. Au cœur de la tempête, une clochette tinte sans arrêt : dring…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धरती की गड़गड़ाहट के साथ आए किंवदंतियों में बताए जीवों के अक्षर। गरजते तूफ़ान के बीच टन-टन घंटी लगातार बज रही है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz tutnjavu tla stižu slova legendarnih zvijeri. Usred bijesne oluje neprestano zvoni zvončić: ciling…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Földmorajlással együtt jelennek meg a legendákban emlegetett vadak betűi. A tomboló viharban egyfolytában csilingel egy csengő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiringi gemuruh bumi, muncullah huruf-huruf binatang dari legenda. Di tengah badai yang mengamuk, bunyi lonceng ting-ting terus terdengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un boato della terra appaiono le lettere delle bestie leggendarie. Nel mezzo della tempesta, un campanello continua a suonare: dlin…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "땅울림과 함께 나타난 것은 전설 속 짐승의 문자들. 휘몰아치는 폭풍 속에서 딸랑딸랑 방울 소리가 계속 울린다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersama gegaran bumi, muncullah huruf-huruf makhluk dalam legenda. Di tengah ribut yang mengganas, bunyi loceng ting-ting terus bergema."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med et drønn fra jorda dukket sagndyrenes tegn opp. I den rasende stormen ringer en bjelle kling-kling uten stans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met donderend geraas verschijnen de legendarische beestletters. In de razende storm blijft een belletje tingelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dudnieniem ziemi pojawiły się znaki-bestie z legend. Pośród szalejącej burzy wciąż dzwoni dzwoneczek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um tremor de terra, surgem as letras das feras lendárias. No meio da tempestade, um sininho não para de tocar: plim!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um tremor de terra surgem as letras das feras lendárias. No meio da tempestade, uma campainha não para de tocar: tlim!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu un cutremur, apar literele fiarelor din legende. În mijlocul furtunii, un clopoțel tot sună, cling-cling."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С гулом земли появились буквы легендарных зверей. В бушующей буре не смолкает звон колокольчика «дзинь»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dunenia zeme sa objavili šelmie znaky z legiend. Uprostred zúriacej búrky stále zvoní zvonček."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ett mullrande dök de upp: tecknen för bestarna i legenderna. Mitt i den vilda stormen klingar en bjällra oavbrutet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ปรากฏพร้อมแผ่นดินสะเทือน คือตัวอักษรสัตว์ในตำนาน ท่ามกลางพายุโหมกระหน่ำ เสียงกระดิ่งกรุ๊งกริ๊งดังไม่หยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeri sarsarak beliren, efsanelerde anlatılan canavar harfler. Esen fırtınanın içinde çın çın bir çan sesi çalmaya devam ediyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З гуркотом землі з'явилися літери легендарних звірів. Серед шаленої бурі не вщухає дзенькіт дзвіночка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xuất hiện giữa tiếng đất rung là những con chữ linh thú trong truyền thuyết. Giữa cơn bão dữ dội, tiếng chuông leng keng vang mãi không ngừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伴随着地鸣出现的，是传说中的野兽文字们。在狂暴的风暴中，叮铃叮铃的铃声响个不停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伴隨著地鳴出現的，是傳說中的野獸文字們。在狂暴的風暴中，叮鈴叮鈴的鈴聲響個不停。"
          }
        }
      }
    },
    "城のように動かない鉄壁" : {
