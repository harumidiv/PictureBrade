            "value" : "Belum sempat menyebar…… sudah dipadamkan……"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spento… prima di potermi propagare…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번지기 전에……꺼져 버렸다……"
