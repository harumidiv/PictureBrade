    "火が2つ重なれば炎！　さっきの「火」とは格が違うぜ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos «火» un sobre l'altre fan «炎», la flama! No soc del mateix nivell que el «火» d'abans!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva ohně nad sebou jsou plamen! Jsem o třídu lepší než ten „火“ předtím!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ”火” oven på hinanden giver ”炎”! Jeg er i en helt anden klasse end ”火” fra før!"
          }
