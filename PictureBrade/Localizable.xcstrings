    "見えない風が、キミのコマを場外まで吹き飛ばすよ" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El meu vent invisible farà volar la teva baldufa fora de l'arena!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neviditelný vítr odfoukne tvou káču z arény"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den usynlige vind blæser din top helt ud af banen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der unsichtbare Wind pustet deinen Kreisel aus der Arena"
