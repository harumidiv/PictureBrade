    "へいらっしゃい！　回転ずしならぬ、回転コマのおすしだよ！" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvingut! No són sushis de cinta: són sushis que giren com baldufes!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vítejte! Suši na pásu? Kdepak, suši na káče!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen, velkommen! Ikke rullebånds-sushi – men snurretop-sushi!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzlich willkommen! Kein Laufband-Sushi, sondern Kreisel-Sushi!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλώς τον! Όχι σούσι σε κυλιόμενο ιμάντα — σούσι σε σβούρα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, welcome! Forget conveyor-belt sushi — this is spinning-top sushi!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Bienvenido! ¡Aquí no hay sushi giratorio, sino sushi de trompo giratorio!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tervetuloa, tervetuloa! Ei liukuhihnasushia – vaan hyrräsushia!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue ! Pas des sushis sur tapis roulant : des sushis qui tournent comme des toupies !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइए, आइए! ये कन्वेयर बेल्ट पर घूमने वाली सुशी नहीं, लट्टू की तरह घूमने वाली सुशी है!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobro došli! Ne suši na pokretnoj traci, nego suši-čigra na vrtnji!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üdv, megjöttél! Ez nem futószalagos szusi, hanem pörgettyűs szusi!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat datang! Bukan sushi berputar, tapi sushi gasing berputar!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto! Non sushi sul nastro: sushi che girano come trottole!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어서 옵쇼! 회전초밥이 아니라 회전팽이 초밥이올시다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat datang! Ini bukan sushi pusing atas tali sawat — ini sushi yang pusing macam gasing!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen, velkommen! Ikke rullebånd-sushi – men snurrebass-sushi!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welkom, welkom! Geen lopendebandsushi, maar draaiende-tol-sushi!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witamy! Sushi z taśmy? Nie, sushi na bączku!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo! Aqui não tem sushi de esteira, tem sushi de pião giratório!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo! Aqui não há sushi de tapete rolante, há sushi de pião giratório!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poftiți, poftiți! Nu sushi pe bandă rulantă, ci sushi pe titirez!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать! У нас не суши на ленте, а суши-волчок на вращении!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitajte! Suši na páse? Kdeže, suši na vĺčikovi!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välkommen in! Inte rullbandssushi – det här är snurrsushi!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชิญค่ะ! ไม่ใช่ซูชิสายพาน แต่เป็นซูชิลูกข่างหมุนติ้ว!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
